      "address": 32,
      "label": "I²C 레지스터 센서",
      "registers": [
        {
          "register": 0,
          "value": 30,
          "writable": false
        },
        {
          "register": 1,
          "value": 0,
          "writable": true
        }
      ]
    }
  ],

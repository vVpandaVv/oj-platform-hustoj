index 0000000000000000000000000000000000000000..e89e6376822a225407b0ffee70de3bbcca81ab1b
--- /dev/null
+++ b/frontend/tests/oj-public-pc-wipe-race.spec.ts
@@ -0,0 +1,138 @@
+// @vitest-environment jsdom
+
+import 'fake-indexeddb/auto'
+
+import { afterEach, expect, it, vi } from 'vitest'
+
+import { isClientError } from '../src/errors'
+import {
+  acquireOjStorageLease,
+  configureOjStorageScope,
+  hasOjStorageScope,
+  isOjStorageScopeRevoked,
+  ojStorageLockName,
+  scopedDatabaseName,
+} from '../src/oj-storage-scope'
+import { deleteCurrentStorage, listProjects, saveProject } from '../src/project/storage'
+import {
+  deferred,
+  indexedDatabaseNames,
+  MockBroadcastChannel,
+  MockLockManager,
+} from './fixtures/oj-storage'
+import { projectFile } from './fixtures/project'
+
+const SCOPE = 'RaceEfGhIjKlMnOpQrStUvWx'
+const KEY = 'AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8'
+
+afterEach(() => {
+  MockBroadcastChannel.reset()
+  vi.restoreAllMocks()
+  vi.unstubAllGlobals()
+  Object.defineProperty(navigator, 'locks', { configurable: true, value: undefined })
+  Object.defineProperty(navigator, 'storage', { configurable: true, value: undefined })
+})
+
+it('exclusive를 먼저 대기시켜 늦은 shared 진입과 blocked DB를 넘긴 뒤 vault를 삭제한다', async () => {
+  const locks = new MockLockManager()
+  MockBroadcastChannel.reset()
+  vi.stubGlobal('BroadcastChannel', MockBroadcastChannel)
+  Object.defineProperty(navigator, 'locks', { configurable: true, value: locks })
+  configureOjStorageScope(SCOPE, KEY)
+  await acquireOjStorageLease()
+
+  const databaseName = scopedDatabaseName('ml-playgrounds')
+  const lockName = ojStorageLockName(SCOPE)
+  const fill = vi.spyOn(Uint8Array.prototype, 'fill')
+
+  for (const request of [
+    () => {
+      throw new DOMException('Lock request denied', 'SecurityError')
+    },
+    () => Promise.reject(new DOMException('Lock request denied', 'SecurityError')),
+  ]) {
+    Object.defineProperty(navigator, 'locks', {
+      configurable: true,
+      value: { request } as unknown as LockManager,
+    })
+    const failure = await deleteCurrentStorage().catch((error: unknown) => error)
+    expect(isClientError(failure) && failure.code).toBe('STORAGE_LOCKED')
+    expect(isOjStorageScopeRevoked()).toBe(false)
+    expect(fill).not.toHaveBeenCalled()
+    expect(MockBroadcastChannel.sent).toEqual([])
+    expect(locks.isHeld(lockName, 'shared')).toBe(true)
+  }
+  Object.defineProperty(navigator, 'locks', { configurable: true, value: locks })
+
+  await saveProject(projectFile())
+  const blocker = await new Promise<IDBDatabase>((resolve, reject) => {
+    const request = indexedDB.open(databaseName)
+    request.onsuccess = () => resolve(request.result)
+    request.onerror = () => reject(request.error ?? new Error('open failed'))
+  })
+  const deleteBlocked = deferred<void>()
+  blocker.onversionchange = () => deleteBlocked.resolve(undefined)
+  const estimateStarted = deferred<void>()
+  const estimateResult = deferred<StorageEstimate>()
+  Object.defineProperty(navigator, 'storage', {
+    configurable: true,
+    value: {
+      estimate: () => {
+        estimateStarted.resolve(undefined)
+        return estimateResult.promise
+      },
+    },
+  })
+  const writing = saveProject(projectFile()).catch((error: unknown) => error)
+  await estimateStarted.promise
+
+  let wipeSettled = false
+  const wiping = deleteCurrentStorage().then(() => {
+    wipeSettled = true
+  })
+  await vi.waitFor(() => expect(locks.isPending(lockName, 'exclusive')).toBe(true))
+
+  let lateSharedAcquired = false
+  const lateShared = locks.hold(lockName, 'shared')
+  void lateShared.acquired.then(() => {
+    lateSharedAcquired = true
+  })
+  await Promise.resolve()
+
+  expect(hasOjStorageScope()).toBe(true)
+  expect(isOjStorageScopeRevoked()).toBe(true)
+  expect(fill).toHaveBeenCalledWith(0)
+  expect(wipeSettled).toBe(false)
+  expect(locks.isPending(lockName, 'exclusive')).toBe(true)
+  expect(locks.isPending(lockName, 'shared')).toBe(true)
+  expect(locks.isHeld(lockName, 'shared')).toBe(true)
+  expect(lateSharedAcquired).toBe(false)
+
+  const exclusiveQueued = locks.events.indexOf(`lock:${lockName}:queued:exclusive`)
+  const lateSharedQueued = locks.events.lastIndexOf(`lock:${lockName}:queued:shared`)
+  expect(exclusiveQueued).toBeGreaterThanOrEqual(0)
+  expect(exclusiveQueued).toBeLessThan(lateSharedQueued)
+
+  estimateResult.resolve({ quota: 1024 * 1024 * 1024, usage: 0 })
+  const writeFailure = await writing
+  expect(isClientError(writeFailure) && writeFailure.code).toBe('STORAGE_LOCKED')
+  await deleteBlocked.promise
+  expect(wipeSettled).toBe(false)
+  expect(locks.isHeld(lockName, 'exclusive')).toBe(true)
+  expect(lateSharedAcquired).toBe(false)
+
+  blocker.close()
+  await wiping
+
+  expect(wipeSettled).toBe(true)
+  expect(locks.events).toContain(`lock:${lockName}:acquired:exclusive`)
+  await lateShared.acquired
+  lateShared.release()
+  await lateShared.finished
+  const futureFailure = await saveProject(projectFile()).catch((error: unknown) => error)
+  expect(isClientError(futureFailure) && futureFailure.code).toBe('STORAGE_LOCKED')
+  const listFailure = await listProjects().catch((error: unknown) => error)
+  expect(isClientError(listFailure) && listFailure.code).toBe('STORAGE_LOCKED')
+  expect(await indexedDatabaseNames()).not.toContain(databaseName)
+  expect(await indexedDatabaseNames()).not.toContain('ml-playgrounds')
+})

+import { readFileSync } from 'node:fs'
+import { join } from 'node:path'
+
+import { describe, expect, it } from 'vitest'
+
+const MAIN = join(import.meta.dirname, '..', 'src', 'main.ts')
+
+describe('OJ storage bootstrap order', () => {
+  it('starts router and app only after scope and shared lease validation', () => {
+    const source = readFileSync(MAIN, 'utf-8')
+    const configure = source.indexOf('configureOjStorageScope(')
+    const register = source.indexOf('registerOjStorageRevokeHandler(')
+    const lease = source.indexOf('await acquireOjStorageLease()')
+    const active = source.indexOf('assertOjStorageActive()')
+    const router = source.indexOf('app.use(router)')
+    const mount = source.indexOf("app.mount('#app')")
+
+    expect(configure).toBeGreaterThan(-1)
+    expect(register).toBeGreaterThan(configure)
+    expect(lease).toBeGreaterThan(register)
+    expect(active).toBeGreaterThan(lease)
+    expect(router).toBeGreaterThan(active)
+    expect(mount).toBeGreaterThan(router)
+  })
+
+  it('drops the host key and revokes the store, host, and Vue app together', () => {
+    const source = readFileSync(MAIN, 'utf-8')
+    const start = source.indexOf('registerOjStorageRevokeHandler((reason) => {')
+    const end = source.indexOf('    })', start)
+    const handler = source.slice(start, end)
+
+    expect(source).toContain("host.storageKey = ''")
+    expect(handler).toContain('projectStore.revoke()')
+    expect(handler).toContain("revokeOjHostBridge(reason !== 'local-wipe')")
+    expect(handler).toContain('app.unmount()')
+  })
+})

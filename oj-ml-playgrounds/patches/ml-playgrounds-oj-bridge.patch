@@ -0,0 +1,36 @@
+import type { DroppedModel, ProjectFile } from './format'
+import type { Identity } from './identity'
+import { identifiedExport, type Translate } from './portfolio-text'
+
+export type ProjectDelivery = (blob: Blob, fileName: string) => void | Promise<void>
+
+export interface IdentifiedExportProject {
+  readonly file: ProjectFile | null
+  update(file: ProjectFile): void
+  exportFile(
+    portfolioMarkdown: string,
+    deliver?: ProjectDelivery,
+    expectedFile?: ProjectFile,
+  ): Promise<DroppedModel[]>
+}
+
+/** Build one coherent snapshot, then either download it or deliver it directly to OJ. */
+export async function exportIdentifiedProject(
+  project: IdentifiedExportProject,
+  identity: Identity,
+  translate: Translate,
+  locale: string,
+  deliver?: ProjectDelivery,
+  now = new Date().toISOString(),
+): Promise<DroppedModel[]> {
+  const file = project.file
+  if (file === null) throw new Error('PROJECT_NOT_OPEN')
+
+  const exported = identifiedExport(file.document, identity, now, translate, locale)
+  const snapshot = { ...file, document: exported.document }
+  project.update(snapshot)
+
+  return deliver === undefined
+    ? project.exportFile(exported.markdown)
+    : project.exportFile(exported.markdown, deliver, snapshot)
+}
diff --git a/frontend/src/project/oj-encrypted-storage.ts b/frontend/src/project/oj-encrypted-storage.ts
new file mode 100644
index 0000000000000000000000000000000000000000..659cc48386e31085ee4dddcf615165dba5391921
--- /dev/null
+++ b/frontend/src/project/oj-encrypted-storage.ts
@@ -0,0 +1,459 @@
+/** Encrypted project vault used only when ML Playgrounds is embedded by OJ. */
+
+import { openDB, type DBSchema, type IDBPDatabase } from 'idb'
+
+import { ClientError } from '../errors'
+import { hashBytes } from '../hash'
+import {
+  assertOjStorageActive,
+  opaqueStorageKey,
+  openBytes,
+  openJson,
+  registerOjStorageRevokeHandler,
+  revokeOjStorageScopeFromDatabaseBlocking,
+  scopedDatabaseName,
+  sealBytes,
+  sealJson,
+  withOjStorageOperation,
+  type SealedBytes,
+} from '../oj-storage-scope'
+import { deleteDatabaseUntilSettled } from './delete-database'
+import {
+  detachMissingAttachments,
+  dropUnknownBackbones,
+  pointsToFile,
+  type ProjectFile,
+} from './format'
+import { migrateProjectDocument } from './migrate'
+import { TASK_TYPES, type ProjectDocument, type TaskType } from './schema'
+
+const BASE_DB_NAME = 'ml-playgrounds'
+const VAULT_VERSION = 1
+const PROJECTS_STORE = 'projects'
+const DATASETS_STORE = 'datasets'
+const MODELS_STORE = 'models'
+const UPDATED_AT_INDEX = 'updatedAt'
+
+interface EncryptedProjectRecord {
+  projectId: string
+  updatedAt: string
+  sizeBytes: number
+  exportedAt?: string
+  sealedDocument: SealedBytes
+}
+
+interface PayloadReference {
+  index: number
+  hash?: string
+}
+
+interface EncryptedDatasetMetadata {
+  version: 1
+  dataset?: PayloadReference
+  test?: PayloadReference
+  predict?: PayloadReference
+  images: Array<[string, number]>
+  attachments: Array<[string, number]>
+  embeddings: Array<[string, number]>
+}
+
+interface EncryptedDatasetRecord {
+  projectId: string
+  sealedMetadata: SealedBytes
+  sealedPayloads: SealedBytes[]
+}
+
+interface EncryptedModelRecord {
+  projectId: string
+  token: string
+  sealedPath: SealedBytes
+  sealedBytes: SealedBytes
+}
+
+interface VaultDB extends DBSchema {
+  [PROJECTS_STORE]: {
+    key: string
+    value: EncryptedProjectRecord
+    indexes: { updatedAt: string }
+  }
+  [DATASETS_STORE]: { key: string; value: EncryptedDatasetRecord }
+  [MODELS_STORE]: { key: [string, string]; value: EncryptedModelRecord }
+}
+
+export interface EncryptedProjectSummary {
+  projectId: string
+  name: string
+  taskType: TaskType | undefined
+  updatedAt: string
+  sizeBytes: number
+  readable: boolean
+}
+
+let connection: Promise<IDBPDatabase<VaultDB>> | null = null
+
+export function encryptedDatabaseName(): string {
+  return scopedDatabaseName(BASE_DB_NAME)
+}
+
+function db(): Promise<IDBPDatabase<VaultDB>> {
+  assertOjStorageActive()
+  connection ??= openDB<VaultDB>(encryptedDatabaseName(), VAULT_VERSION, {
+    upgrade(database) {
+      if (!database.objectStoreNames.contains(PROJECTS_STORE)) {
+        const projects = database.createObjectStore(PROJECTS_STORE, { keyPath: 'projectId' })
+        projects.createIndex(UPDATED_AT_INDEX, 'updatedAt')
+      }
+      if (!database.objectStoreNames.contains(DATASETS_STORE)) {
+        database.createObjectStore(DATASETS_STORE)
+      }
+      if (!database.objectStoreNames.contains(MODELS_STORE)) {
+        database.createObjectStore(MODELS_STORE, { keyPath: ['projectId', 'token'] })
+      }
+    },
+    blocked() {
+      connection = null
+    },
+    blocking(_currentVersion, blockedVersion, event) {
+      if (blockedVersion === null || event.newVersion === null) {
+        // Revoke synchronously before closing so no continuation can reopen after deletion.
+        revokeOjStorageScopeFromDatabaseBlocking()
+      }
+      ;(event.target as IDBDatabase | null)?.close()
+      connection = null
+    },
+  }).catch((error: unknown) => {
+    connection = null
+    throw error
+  })
+  return connection.then((database) => {
+    assertOjStorageActive()
+    return database
+  })
+}
+
+function modelKeyRange(projectId: string): IDBKeyRange {
+  return IDBKeyRange.bound([projectId], [projectId, []])
+}
+
+async function packDatasets(
+  projectId: string,
+  project: ProjectFile,
+): Promise<EncryptedDatasetRecord | null> {
+  const raw: Uint8Array[] = []
+  const add = (bytes: Uint8Array): number => raw.push(bytes) - 1
+  const metadata: EncryptedDatasetMetadata = {
+    version: 1,
+    images: [],
+    attachments: [],
+    embeddings: [],
+  }
+
+  if (project.dataset)
+    metadata.dataset = { index: add(project.dataset.bytes), hash: project.dataset.hash }
+  if (project.testDataset)
+    metadata.test = { index: add(project.testDataset.bytes), hash: project.testDataset.hash }
+  if (project.predictDataset) {
+    metadata.predict = {
+      index: add(project.predictDataset.bytes),
+      hash: project.predictDataset.hash,
+    }
+  }
+  for (const [path, bytes] of project.images) metadata.images.push([path, add(bytes)])
+  for (const [path, bytes] of project.attachments) metadata.attachments.push([path, add(bytes)])
+  for (const [path, bytes] of project.embeddings) metadata.embeddings.push([path, add(bytes)])
+  if (raw.length === 0) return null
+
+  const sealedPayloads: SealedBytes[] = []
+  for (let index = 0; index < raw.length; index += 1) {
+    sealedPayloads.push(await sealBytes(raw[index]!, `${projectId}:dataset:${index}`))
+  }
+  return {
+    projectId,
+    sealedMetadata: await sealJson(metadata, `${projectId}:dataset-metadata`),
+    sealedPayloads,
+  }
+}
+
+function validReference(value: unknown, payloadCount: number): value is PayloadReference {
+  if (typeof value !== 'object' || value === null) return false
+  const reference = value as { index?: unknown; hash?: unknown }
+  return (
+    Number.isSafeInteger(reference.index) &&
+    Number(reference.index) >= 0 &&
+    Number(reference.index) < payloadCount &&
+    (reference.hash === undefined || typeof reference.hash === 'string')
+  )
+}
+
+function validPathEntries(value: unknown, payloadCount: number): value is Array<[string, number]> {
+  return (
+    Array.isArray(value) &&
+    value.every(
+      (entry) =>
+        Array.isArray(entry) &&
+        entry.length === 2 &&
+        typeof entry[0] === 'string' &&
+        Number.isSafeInteger(entry[1]) &&
+        entry[1] >= 0 &&
+        entry[1] < payloadCount,
+    )
+  )
+}
+
+async function unpackDatasets(projectId: string, record: EncryptedDatasetRecord | undefined) {
+  if (record === undefined) {
+    return {
+      dataset: undefined,
+      testDataset: undefined,
+      predictDataset: undefined,
+      images: new Map<string, Uint8Array>(),
+      attachments: new Map<string, Uint8Array>(),
+      embeddings: new Map<string, Uint8Array>(),
+    }
+  }
+  const metadata = await openJson<EncryptedDatasetMetadata>(
+    record.sealedMetadata,
+    `${projectId}:dataset-metadata`,
+  )
+  const count = record.sealedPayloads.length
+  if (
+    metadata?.version !== 1 ||
+    !validPathEntries(metadata.images, count) ||
+    !validPathEntries(metadata.attachments, count) ||
+    !validPathEntries(metadata.embeddings, count) ||
+    (metadata.dataset !== undefined && !validReference(metadata.dataset, count)) ||
+    (metadata.test !== undefined && !validReference(metadata.test, count)) ||
+    (metadata.predict !== undefined && !validReference(metadata.predict, count))
+  ) {
+    throw new ClientError('STORAGE_LOCKED')
+  }
+
+  const payloads: Uint8Array[] = []
+  for (let index = 0; index < count; index += 1) {
+    payloads.push(await openBytes(record.sealedPayloads[index]!, `${projectId}:dataset:${index}`))
+  }
+  const mapped = (entries: Array<[string, number]>): Map<string, Uint8Array> =>
+    new Map(entries.map(([path, index]) => [path, payloads[index]!] as const))
+  const body = (reference: PayloadReference | undefined) => {
+    if (reference === undefined) return undefined
+    const bytes = payloads[reference.index]!
+    return { bytes, hash: reference.hash ?? hashBytes(bytes) }
+  }
+  return {
+    dataset: body(metadata.dataset),
+    testDataset: body(metadata.test),
+    predictDataset: body(metadata.predict),
+    images: mapped(metadata.images),
+    attachments: mapped(metadata.attachments),
+    embeddings: mapped(metadata.embeddings),
+  }
+}
+
+async function packModels(projectId: string, models: Map<string, Uint8Array>) {
+  const records: EncryptedModelRecord[] = []
+  for (const [path, bytes] of models) {
+    const token = await opaqueStorageKey(`${projectId}:model-token`, path)
+    records.push({
+      projectId,
+      token,
+      sealedPath: await sealJson(path, `${projectId}:model-path:${token}`),
+      sealedBytes: await sealBytes(bytes, `${projectId}:model-bytes:${token}`),
+    })
+  }
+  return records
+}
+
+export async function saveEncryptedProject(project: ProjectFile, sizeBytes: number): Promise<void> {
+  return withOjStorageOperation(async (checkpoint) => {
+    const projectId = project.document.manifest.projectId
+    const database = await db()
+    checkpoint()
+    const before = await database.get(PROJECTS_STORE, projectId)
+    checkpoint()
+    const projectRecord: EncryptedProjectRecord = {
+      projectId,
+      updatedAt: project.document.manifest.updatedAt,
+      sizeBytes,
+      sealedDocument: await sealJson(project.document, `${projectId}:document`),
+      ...(before?.exportedAt === undefined ? {} : { exportedAt: before.exportedAt }),
+    }
+    const datasetRecord = await packDatasets(projectId, project)
+    const modelRecords = await packModels(projectId, project.models)
+
+    // Last checkpoint before a write transaction. A later revoke waits for this tracked operation
+    // to settle and deletes any commit before acknowledging the wipe.
+    checkpoint()
+    const transaction = database.transaction(
+      [PROJECTS_STORE, DATASETS_STORE, MODELS_STORE],
+      'readwrite',
+    )
+    await transaction.objectStore(PROJECTS_STORE).put(projectRecord)
+    if (datasetRecord === null) await transaction.objectStore(DATASETS_STORE).delete(projectId)
+    else await transaction.objectStore(DATASETS_STORE).put(datasetRecord, projectId)
+    const models = transaction.objectStore(MODELS_STORE)
+    await models.delete(modelKeyRange(projectId))
+    for (const record of modelRecords) await models.put(record)
+    await transaction.done
+    checkpoint()
+  })
+}
+
+function paired(
+  ref: { path: string } | undefined,
+  body: unknown,
+  images: Map<string, Uint8Array>,
+): boolean {
+  if (ref === undefined) return body === undefined
+  if (pointsToFile(ref)) return body !== undefined
+  return [...images.keys()].some((path) => path.startsWith(ref.path))
+}
+
+export async function loadEncryptedProject(projectId: string): Promise<ProjectFile | null> {
+  return withOjStorageOperation(async (checkpoint) => {
+    const database = await db()
+    checkpoint()
+    const transaction = database.transaction([PROJECTS_STORE, DATASETS_STORE, MODELS_STORE])
+    // Web Crypto 대기 중에는 IndexedDB 트랜잭션이 자동 커밋될 수 있으므로 먼저 전부 읽는다.
+    const [record, datasetRecord, storedModels] = await Promise.all([
+      transaction.objectStore(PROJECTS_STORE).get(projectId),
+      transaction.objectStore(DATASETS_STORE).get(projectId),
+      transaction.objectStore(MODELS_STORE).getAll(modelKeyRange(projectId)),
+    ])
+    await transaction.done
+    checkpoint()
+    if (!record) return null
+    const projectDocument = migrateProjectDocument(
+      await openJson<ProjectDocument>(record.sealedDocument, `${projectId}:document`),
+    )
+    const bodies = await unpackDatasets(projectId, datasetRecord)
+    if (
+      !paired(projectDocument.settings.data.dataset, bodies.dataset?.bytes, bodies.images) ||
+      !paired(projectDocument.settings.data.testDataset, bodies.testDataset, bodies.images) ||
+      !paired(projectDocument.settings.data.predictDataset, bodies.predictDataset, bodies.images)
+    ) {
+      throw new ClientError('PROJECT_FILE_INVALID', { path: 'settings.data', issues: 1 })
+    }
+
+    const models = new Map<string, Uint8Array>()
+    for (const stored of storedModels) {
+      const path = await openJson<string>(
+        stored.sealedPath,
+        `${projectId}:model-path:${stored.token}`,
+      )
+      if (typeof path !== 'string' || path.length === 0) throw new ClientError('STORAGE_LOCKED')
+      models.set(
+        path,
+        await openBytes(stored.sealedBytes, `${projectId}:model-bytes:${stored.token}`),
+      )
+    }
+
+    checkpoint()
+    return {
+      document: detachMissingAttachments(projectDocument, bodies.attachments),
+      dataset: bodies.dataset,
+      testDataset: bodies.testDataset,
+      predictDataset: bodies.predictDataset,
+      models,
+      images: bodies.images,
+      attachments: bodies.attachments,
+      embeddings: dropUnknownBackbones(bodies.embeddings),
+    }
+  })
+}
+
+function taskTypeOf(value: unknown): TaskType | undefined {
+  return TASK_TYPES.includes(value as TaskType) ? (value as TaskType) : undefined
+}
+
+export async function listEncryptedProjects(): Promise<EncryptedProjectSummary[]> {
+  return withOjStorageOperation(async (checkpoint) => {
+    const database = await db()
+    checkpoint()
+    const records = (await database.getAllFromIndex(PROJECTS_STORE, UPDATED_AT_INDEX)).reverse()
+    const summaries: EncryptedProjectSummary[] = []
+    for (const record of records) {
+      try {
+        const projectDocument = await openJson<ProjectDocument>(
+          record.sealedDocument,
+          `${record.projectId}:document`,
+        )
+        const name = projectDocument?.manifest?.name
+        summaries.push({
+          projectId: record.projectId,
+          name: typeof name === 'string' ? name : '',
+          taskType: taskTypeOf(projectDocument?.manifest?.taskType),
+          updatedAt: record.updatedAt,
+          sizeBytes: record.sizeBytes,
+          readable: typeof name === 'string',
+        })
+      } catch {
+        summaries.push({
+          projectId: record.projectId,
+          name: '',
+          taskType: undefined,
+          updatedAt: record.updatedAt,
+          sizeBytes: record.sizeBytes,
+          readable: false,
+        })
+      }
+    }
+    checkpoint()
+    return summaries
+  })
+}
+
+export async function markEncryptedProjectExported(projectId: string, at: string): Promise<void> {
+  return withOjStorageOperation(async (checkpoint) => {
+    const database = await db()
+    checkpoint()
+    const transaction = database.transaction(PROJECTS_STORE, 'readwrite')
+    const record = await transaction.store.get(projectId)
+    if (record) await transaction.store.put({ ...record, exportedAt: at })
+    await transaction.done
+    checkpoint()
+  })
+}
+
+export async function readEncryptedProjectExportedAt(projectId: string): Promise<string | null> {
+  return withOjStorageOperation(async (checkpoint) => {
+    const database = await db()
+    checkpoint()
+    const exportedAt = (await database.get(PROJECTS_STORE, projectId))?.exportedAt ?? null
+    checkpoint()
+    return exportedAt
+  })
+}
+
+export async function deleteEncryptedProject(projectId: string): Promise<void> {
+  return withOjStorageOperation(async (checkpoint) => {
+    const database = await db()
+    checkpoint()
+    const transaction = database.transaction(
+      [PROJECTS_STORE, DATASETS_STORE, MODELS_STORE],
+      'readwrite',
+    )
+    await transaction.objectStore(PROJECTS_STORE).delete(projectId)
+    await transaction.objectStore(DATASETS_STORE).delete(projectId)
+    await transaction.objectStore(MODELS_STORE).delete(modelKeyRange(projectId))
+    await transaction.done
+    checkpoint()
+  })
+}
+
+export async function closeEncryptedStorage(): Promise<void> {
+  const pending = connection
+  connection = null
+  if (!pending) return
+  try {
+    ;(await pending).close()
+  } catch {
+    // A revoked open request may reject instead of yielding a connection. It is already closed.
+  }
+}
+
+export async function deleteEncryptedStorage(): Promise<void> {
+  await closeEncryptedStorage()
+  await deleteDatabaseUntilSettled(encryptedDatabaseName())
+}
+
+registerOjStorageRevokeHandler(closeEncryptedStorage)

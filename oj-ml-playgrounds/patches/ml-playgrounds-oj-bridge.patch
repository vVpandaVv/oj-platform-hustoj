+    blob: new Blob(['mlpx']),
+    dropped: [],
+    contentHash: 'a'.repeat(64),
+  })
+})
+
+afterEach(() => {
+  useProjectStore().close()
+  vi.useRealTimers()
+  vi.resetAllMocks()
+})
+
+describe('project writes share one in-flight storage operation', () => {
+  it('shares autosave with result-navigation flush and an unchanged save', async () => {
+    const store = useProjectStore()
+    const file = snapshot('trained')
+    const pending = deferred()
+    vi.mocked(saveProject).mockReturnValueOnce(pending.promise)
+    store.update(file)
+    await vi.advanceTimersByTimeAsync(AUTOSAVE_DELAY_MS)
+    const flushed = store.flush()
+    const saved = store.save(file)
+
+    expect(saveProject).toHaveBeenCalledExactlyOnceWith(file)
+    expect(store.saving).toBe(true)
+    pending.resolve()
+    await Promise.all([flushed, saved])
+    expect(saveProject).toHaveBeenCalledOnce()
+    expect(store.dirty).toBe(false)
+    expect(store.saving).toBe(false)
+  })
+
+  it('coalesces intervening edits and waits for the latest snapshot to finish', async () => {
+    const store = useProjectStore()
+    const first = deferred()
+    const last = deferred()
+    vi.mocked(saveProject).mockReturnValueOnce(first.promise).mockReturnValueOnce(last.promise)
+    const initial = snapshot('initial')
+    const latest = snapshot('latest')
+    const saving = store.save(initial)
+    store.update(snapshot('intermediate'))
+    store.update(latest)
+    const flushed = store.flush()
+    const finished = vi.fn()
+    void flushed.then(finished)
+
+    expect(saveProject).toHaveBeenCalledExactlyOnceWith(initial)
+    first.resolve()
+    await vi.waitFor(() => expect(saveProject).toHaveBeenCalledTimes(2))
+    expect(vi.mocked(saveProject).mock.calls[1]?.[0]).toBe(latest)
+    expect(finished).not.toHaveBeenCalled()
+    expect(store.dirty).toBe(true)
+    expect(store.saving).toBe(true)
+    last.resolve()
+    await Promise.all([saving, flushed])
+    expect(store.file).toBe(latest)
+    expect(store.dirty).toBe(false)
+    expect(store.saving).toBe(false)
+    await vi.advanceTimersByTimeAsync(AUTOSAVE_DELAY_MS * 2)
+    expect(saveProject).toHaveBeenCalledTimes(2)
+  })
+
+  it('shares a failure without clearing the latest dirty snapshot, then permits retry', async () => {
+    const store = useProjectStore()
+    const pending = deferred()
+    const error = new Error('storage failed')
+    vi.mocked(saveProject).mockReturnValueOnce(pending.promise)
+    const saving = store.save(snapshot('old'))
+    const latest = snapshot('unsaved edit')
+    store.update(latest)
+    const flushed = store.flush()
+    const rejected = Promise.all([
+      expect(saving).rejects.toBe(error),
+      expect(flushed).rejects.toBe(error),
+    ])
+    pending.reject(error)
+    await rejected
+
+    expect(saveProject).toHaveBeenCalledOnce()
+    expect(store.file).toBe(latest)
+    expect(store.dirty).toBe(true)
+    expect(store.savedAt).toBeNull()
+    expect(store.saving).toBe(false)
+    await store.flush()
+    expect(vi.mocked(saveProject).mock.calls[1]?.[0]).toBe(latest)
+    expect(store.dirty).toBe(false)
+  })
+
+  it('preserves dirty when the follow-up snapshot fails', async () => {
+    const store = useProjectStore()
+    const pending = deferred()
+    const error = new Error('second write failed')
+    vi.mocked(saveProject).mockReturnValueOnce(pending.promise).mockRejectedValueOnce(error)
+    const saving = store.save(snapshot('first'))
+    store.update(snapshot('latest'))
+    const rejected = expect(saving).rejects.toBe(error)
+    pending.resolve()
+    await rejected
+    expect(store.dirty).toBe(true)
+    expect(store.saving).toBe(false)
+    await store.flush()
+    expect(store.dirty).toBe(false)
+  })
+
+  it('does not mark a closed project dirty or saved when its write completes', async () => {
+    const store = useProjectStore()
+    const pending = deferred()
+    vi.mocked(saveProject).mockReturnValueOnce(pending.promise)
+    const saving = store.save(snapshot('closed'))
+    store.close()
+    pending.resolve()
+    await saving
+    expect(store.file).toBeNull()
+    expect(store.dirty).toBe(false)
+    expect(store.savedAt).toBeNull()
+    expect(store.saving).toBe(false)
+  })
+
+  it('does not overwrite state after closing and reopening the same project id', async () => {
+    const store = useProjectStore()
+    const pending = deferred()
+    vi.mocked(saveProject).mockReturnValueOnce(pending.promise)
+    const saving = store.save(snapshot('old session'))
+    store.close()
+    const loaded = snapshot('reopened')
+    vi.mocked(loadProject).mockResolvedValueOnce(loaded)
+    await store.open('project-1')
+    const loadedAt = store.savedAt
+    pending.resolve()

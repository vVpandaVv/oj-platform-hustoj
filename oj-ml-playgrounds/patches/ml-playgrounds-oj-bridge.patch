+import { expect, it, vi } from 'vitest'
+
+import {
+  exportIdentifiedProject,
+  type IdentifiedExportProject,
+  type ProjectDelivery,
+} from '../src/project/identified-export'
+import type { ProjectFile } from '../src/project/format'
+import { projectFile } from './fixtures/project'
+
+it('submits one current in-memory snapshot through the supplied OJ delivery function', async () => {
+  let current: ProjectFile | null = projectFile()
+  const delivered = vi.fn(async (blob: Blob, fileName: string) => {
+    expect(await blob.text()).toBe('mlpx')
+    expect(fileName).toBe('project.mlpx')
+  })
+  const update = vi.fn((next: ProjectFile) => {
+    current = next
+  })
+  const exportFile = vi.fn(
+    async (markdown: string, deliver?: ProjectDelivery, expectedFile?: ProjectFile) => {
+      expect(markdown).toContain('student-17')
+      expect(expectedFile).toBe(current)
+      if (deliver !== undefined) await deliver(new Blob(['mlpx']), 'project.mlpx')
+      return []
+    },
+  )
+  const project: IdentifiedExportProject = {
+    get file() {
+      return current
+    },
+    update,
+    exportFile,
+  }
+
+  await exportIdentifiedProject(
+    project,
+    { name: 'Iris', studentId: 'student-17', studentName: 'Learner' },
+    (key) => key,
+    'en',
+    delivered,
+    '2026-09-01T00:00:00.000Z',
+  )
+
+  expect(update).toHaveBeenCalledOnce()
+  expect(current?.document.manifest).toMatchObject({
+    name: 'Iris',
+    locale: 'en',
+    updatedAt: '2026-09-01T00:00:00.000Z',
+    student: { studentId: 'student-17', name: 'Learner' },
+  })
+  expect(exportFile).toHaveBeenCalledOnce()
+  expect(delivered).toHaveBeenCalledOnce()
+  expect(delivered.mock.calls[0]?.[1]).toBe('project.mlpx')
+})
+
+it('does not fabricate a submission when no project is open', async () => {
+  const project: IdentifiedExportProject = {
+    file: null,
+    update: vi.fn(),
+    exportFile: vi.fn(),
+  }
+
+  await expect(
+    exportIdentifiedProject(
+      project,
+      { name: '', studentId: '', studentName: '' },
+      (key) => key,
+      'en',
+    ),
+  ).rejects.toThrow('PROJECT_NOT_OPEN')
+  expect(project.update).not.toHaveBeenCalled()
+  expect(project.exportFile).not.toHaveBeenCalled()
+})

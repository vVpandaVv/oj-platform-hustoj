+  next.split = { ...next.split, method: 'holdout', stratify: false }
+  return next
+}
+
+const dataset = (classes: number, rows = classes): Dataset => ({
+  columns: ['feature', 'target'],
+  rows: Array.from({ length: rows }, (_, index) => [String(index), String(index % classes)]),

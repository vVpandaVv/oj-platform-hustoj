+/**
+ * OJ 제출·사유 버튼까지 있는 좁은 도구 막대는 바깥 간격을 줄인다.
+ * 높이를 바꾸면 `--shell-top`과 붙박이 동작 바의 위치가 어긋나므로 높이는 유지한다.
+ * 이 검사는 CSS 계약을 지키며, 실제 화면의 픽셀 배치를 측정하는 검사는 아니다.
+ */
+describe('좁은 도구 막대는 간격만 줄이고 높이를 유지한다', () => {
+  function toolbarClasses(source: string): string[] {
+    const header = new RegExp(String.raw`<header\b(${ATTRS})>`).exec(source)?.[1] ?? ''
+    return (/\bclass="([^"]*)"/.exec(header)?.[1] ?? '').split(/\s+/).filter(Boolean)
+  }
+
+  it('여러 줄인 머리 태그의 클래스만 읽고 내부 간격은 읽지 않는다', () => {
+    const source = '<header\n class="h-toolbar gap-1 md:gap-3"\n><div class="gap-8"></div></header>'
+    expect(toolbarClasses(source)).toEqual(['h-toolbar', 'gap-1', 'md:gap-3'])
+    expect(toolbarClasses('<div class="h-toolbar gap-1 md:gap-3"></div>')).toEqual([])
+  })
+
+  it('작은 화면에서만 간격을 줄인다', () => {
+    const source = readFileSync(join(SRC, 'components', 'AppToolbar.vue'), 'utf-8')
+    expect(toolbarClasses(source).filter((name) => /(^|:)gap-/.test(name))).toEqual([
+      'gap-1',
+      'md:gap-3',
+    ])
+  })
+
+  it('높이는 모든 폭에서 기존 도구 막대 토큰을 유지한다', () => {
+    const source = readFileSync(join(SRC, 'components', 'AppToolbar.vue'), 'utf-8')
+    expect(toolbarClasses(source).filter((name) => /(^|:)h-/.test(name))).toEqual(['h-toolbar'])
+    expect(toolbarClasses(source)).toContain('shrink-0')
+  })
+})

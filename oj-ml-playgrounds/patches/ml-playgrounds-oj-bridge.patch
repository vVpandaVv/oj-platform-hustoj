+export type MockLockMode = 'shared' | 'exclusive'
+
+export interface Deferred<T> {
+  readonly promise: Promise<T>
+  readonly resolve: (value: T | PromiseLike<T>) => void
+  readonly reject: (reason?: unknown) => void
+}
+
+export function deferred<T>(): Deferred<T> {
+  let resolve!: (value: T | PromiseLike<T>) => void
+  let reject!: (reason?: unknown) => void
+  const promise = new Promise<T>((resolvePromise, rejectPromise) => {
+    resolve = resolvePromise
+    reject = rejectPromise
+  })
+  return { promise, resolve, reject }
+}
+
+interface PendingLockRequest {
+  readonly mode: MockLockMode
+  readonly grant: () => void
+}
+
+interface LockState {
+  readonly holders: Map<symbol, MockLockMode>
+  readonly pending: PendingLockRequest[]
+}
+
+export interface HeldMockLock {
+  readonly acquired: Promise<void>
+  readonly finished: Promise<void>
+  readonly release: () => void
+}
+
+type MockLockCallback<T> = (lock: Lock | null) => T | PromiseLike<T>
+
+/**
+ * FIFO Web Locks model used by the OJ storage lifecycle tests.
+ *
+ * A shared callback may stay pending for the whole test, and an exclusive request queued behind it
+ * cannot overtake it. Shared requests queued after an exclusive request also stay behind that
+ * exclusive request, matching the fairness property the wipe barrier relies on.
+ */
+export class MockLockManager {
+  readonly events: string[]
+  private readonly states = new Map<string, LockState>()
+
+  constructor(events: string[] = []) {
+    this.events = events
+  }
+
+  request<T>(name: string, callback: MockLockCallback<T>): Promise<T>
+  request<T>(name: string, options: LockOptions, callback: MockLockCallback<T>): Promise<T>
+  request<T>(
+    name: string,
+    optionsOrCallback: LockOptions | MockLockCallback<T>,
+    maybeCallback?: MockLockCallback<T>,
+  ): Promise<T> {
+    const options = typeof optionsOrCallback === 'function' ? undefined : optionsOrCallback
+    const callback = typeof optionsOrCallback === 'function' ? optionsOrCallback : maybeCallback
+    if (callback === undefined) return Promise.reject(new TypeError('lock callback is required'))
+    const mode: MockLockMode = options?.mode === 'shared' ? 'shared' : 'exclusive'
+
+    return new Promise<T>((resolve, reject) => {
+      const state = this.state(name)
+      const request: PendingLockRequest = {
+        mode,
+        grant: () => {
+          const token = Symbol(name)
+          state.holders.set(token, mode)
+          this.record(name, 'acquired', mode)
+          const lock = { name, mode } as Lock
+          void Promise.resolve()
+            .then(() => callback(lock))
+            .then(resolve, reject)
+            .finally(() => {
+              state.holders.delete(token)
+              this.record(name, 'released', mode)
+              this.pump(name, state)
+            })
+        },
+      }
+      state.pending.push(request)
+      this.record(name, 'queued', mode)
+      this.pump(name, state)
+    })
+  }
+
+  hold(name: string, mode: MockLockMode): HeldMockLock {
+    const acquired = deferred<void>()
+    const releaseGate = deferred<void>()
+    let released = false
+    const finished = this.request(name, { mode }, async () => {
+      acquired.resolve(undefined)
+      await releaseGate.promise
+    })
+    return {
+      acquired: acquired.promise,
+      finished,
+      release: () => {
+        if (released) return
+        released = true
+        releaseGate.resolve(undefined)
+      },
+    }
+  }
+
+  isHeld(name: string, mode?: MockLockMode): boolean {
+    const holders = this.states.get(name)?.holders.values()
+    if (holders === undefined) return false
+    return [...holders].some((heldMode) => mode === undefined || heldMode === mode)
+  }
+
+  isPending(name: string, mode?: MockLockMode): boolean {
+    return (
+      this.states
+        .get(name)
+        ?.pending.some((request) => mode === undefined || request.mode === mode) ?? false
+    )
+  }
+
+  private state(name: string): LockState {
+    const existing = this.states.get(name)
+    if (existing !== undefined) return existing
+    const created: LockState = { holders: new Map(), pending: [] }
+    this.states.set(name, created)
+    return created
+  }
+
+  private pump(name: string, state: LockState): void {
+    if ([...state.holders.values()].includes('exclusive')) return
+
+    if (state.holders.size > 0) {
+      while (state.pending[0]?.mode === 'shared') state.pending.shift()?.grant()
+      return
+    }
+
+    const first = state.pending.shift()
+    if (first === undefined) {
+      this.states.delete(name)
+      return
+    }
+    first.grant()
+    if (first.mode === 'shared') {
+      while (state.pending[0]?.mode === 'shared') state.pending.shift()?.grant()
+    }
+  }
+
+  private record(name: string, state: 'queued' | 'acquired' | 'released', mode: MockLockMode) {
+    this.events.push(`lock:${name}:${state}:${mode}`)
+  }
+}
+
+type MockMessageListener = EventListenerOrEventListenerObject
+
+export interface SentBroadcastMessage {
+  readonly channel: string
+  readonly data: unknown
+}
+
+/** In-memory same-origin BroadcastChannel rooms with delivery to peers, never to the sender. */
+export class MockBroadcastChannel {
+  static readonly sent: SentBroadcastMessage[] = []
+  private static readonly rooms = new Map<string, Set<MockBroadcastChannel>>()
+
+  readonly name: string
+  onmessage: ((event: MessageEvent<unknown>) => void) | null = null
+  private readonly listeners = new Set<MockMessageListener>()
+  private closed = false
+
+  constructor(name: string) {
+    this.name = name
+    const room = MockBroadcastChannel.rooms.get(name) ?? new Set<MockBroadcastChannel>()
+    room.add(this)
+    MockBroadcastChannel.rooms.set(name, room)
+  }
+
+  static reset(): void {
+    for (const room of MockBroadcastChannel.rooms.values()) {
+      for (const channel of room) channel.closed = true
+    }
+    MockBroadcastChannel.rooms.clear()
+    MockBroadcastChannel.sent.length = 0
+  }
+
+  postMessage(data: unknown): void {
+    if (this.closed) throw new DOMException('Channel is closed', 'InvalidStateError')
+    MockBroadcastChannel.sent.push({ channel: this.name, data })
+    for (const peer of MockBroadcastChannel.rooms.get(this.name) ?? []) {
+      if (peer === this || peer.closed) continue
+      queueMicrotask(() => peer.deliver(data))
+    }
+  }
+
+  addEventListener(type: string, listener: MockMessageListener): void {
+    if (type === 'message') this.listeners.add(listener)
+  }
+
+  removeEventListener(type: string, listener: MockMessageListener): void {
+    if (type === 'message') this.listeners.delete(listener)
+  }
+
+  close(): void {
+    if (this.closed) return
+    this.closed = true
+    const room = MockBroadcastChannel.rooms.get(this.name)
+    room?.delete(this)
+    if (room?.size === 0) MockBroadcastChannel.rooms.delete(this.name)
+  }
+
+  private deliver(data: unknown): void {
+    if (this.closed) return
+    const event = new MessageEvent<unknown>('message', { data })
+    this.onmessage?.(event)
+    for (const listener of this.listeners) {
+      if (typeof listener === 'function') listener(event)
+      else listener.handleEvent(event)
+    }
+  }
+}
+
+export async function indexedDatabaseNames(): Promise<string[]> {
+  return (await indexedDB.databases())
+    .map((database) => database.name)
+    .filter((name): name is string => typeof name === 'string')
+}

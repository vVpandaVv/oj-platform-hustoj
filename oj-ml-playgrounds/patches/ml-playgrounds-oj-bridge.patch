+// @vitest-environment jsdom
+
+import 'fake-indexeddb/auto'
+
+import { afterEach, expect, it, vi } from 'vitest'
+
+import { isClientError } from '../src/errors'
+import {
+  acquireOjStorageLease,
+  configureOjStorageScope,
+  hasOjStorageScope,
+  isOjStorageScopeRevoked,
+  ojStorageControlChannelName,
+  ojStorageLockName,
+  ojStorageRevokeMessage,
+  scopedDatabaseName,
+} from '../src/oj-storage-scope'
+import { saveProject } from '../src/project/storage'
+import { indexedDatabaseNames, MockBroadcastChannel, MockLockManager } from './fixtures/oj-storage'
+import { projectFile } from './fixtures/project'
+
+const SCOPE = 'BlockEfGhIjKlMnOpQrStUvWx'
+const KEY = 'AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8'
+
+afterEach(() => {
+  MockBroadcastChannel.reset()
+  vi.restoreAllMocks()
+  vi.unstubAllGlobals()
+  Object.defineProperty(navigator, 'locks', { configurable: true, value: undefined })
+})
+
+it('native deleteDatabase의 null versionchange는 즉시 revoke하고 미래 작업을 잠근다', async () => {
+  const locks = new MockLockManager()
+  MockBroadcastChannel.reset()
+  vi.stubGlobal('BroadcastChannel', MockBroadcastChannel)
+  Object.defineProperty(navigator, 'locks', { configurable: true, value: locks })
+  const dispatch = vi.spyOn(IDBDatabase.prototype, 'dispatchEvent')
+
+  configureOjStorageScope(SCOPE, KEY)
+  await acquireOjStorageLease()
+  await saveProject(projectFile())
+
+  const databaseName = scopedDatabaseName('ml-playgrounds')
+  const deleting = new Promise<void>((resolve, reject) => {
+    const request = indexedDB.deleteDatabase(databaseName)
+    request.onsuccess = () => resolve()
+    request.onerror = () => reject(request.error ?? new Error('deleteDatabase failed'))
+  })
+
+  await vi.waitFor(() => expect(isOjStorageScopeRevoked()).toBe(true))
+  expect(hasOjStorageScope()).toBe(true)
+  const versionChange = dispatch.mock.calls
+    .map(([event]) => event)
+    .find((event) => event.type === 'versionchange') as IDBVersionChangeEvent | undefined
+  expect(versionChange?.newVersion).toBeNull()
+
+  const expectedMessage = ojStorageRevokeMessage(SCOPE)
+  expect(MockBroadcastChannel.sent).toContainEqual({
+    channel: ojStorageControlChannelName(SCOPE),
+    data: expectedMessage,
+  })
+  expect(JSON.stringify(MockBroadcastChannel.sent)).not.toContain(KEY)
+  const futureFailure = await saveProject(projectFile()).catch((error: unknown) => error)
+  expect(isClientError(futureFailure) && futureFailure.code).toBe('STORAGE_LOCKED')
+
+  await deleting
+  await vi.waitFor(() => expect(locks.isHeld(ojStorageLockName(SCOPE), 'shared')).toBe(false))
+  expect(await indexedDatabaseNames()).not.toContain(databaseName)
+  expect(await indexedDatabaseNames()).not.toContain('ml-playgrounds')
+})

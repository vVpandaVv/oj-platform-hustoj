+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { useTraining } from '../src/composables/useTraining'
+import type { TrainRequest, WorkerMessage } from '../src/ml/worker/protocol'
+import type { TrainWorker } from '../src/ml/worker/client'
+import { ojHostConfig } from '../src/oj-host-v2'
+import {
+  ojAlgorithmPolicyIssue,
+  ojSelectionPolicyIssue,
+  ojSubmissionPolicyIssue,
+  ojTaskTypePolicyIssue,
+  parseOjAssignmentPolicy,
+} from '../src/oj-assignment-policy'
+import { policyHost } from './fixtures/oj-assignment-policy'
+import { experiment, projectFile, run } from './fixtures/project'
+
+afterEach(() => {
+  ojHostConfig.value = null
+})
+
+describe('OJ assignment policy contract', () => {
+  it.each([
+    null,
+    undefined,
+    {},
+    { version: 2, allowedTaskTypes: ['classification'], allowedAlgorithms: [] },
+    { version: 1, allowedTaskTypes: [], allowedAlgorithms: [] },
+    { version: 1, allowedTaskTypes: ['classification', 'classification'], allowedAlgorithms: [] },
+    { version: 1, allowedTaskTypes: ['__proto__'], allowedAlgorithms: [] },
+    { version: 1, allowedTaskTypes: ['classification'], allowedAlgorithms: null },
+    { version: 1, allowedTaskTypes: ['classification'], allowedAlgorithms: ['<script>'] },
+    { version: 1, allowedTaskTypes: ['classification'], allowedAlgorithms: ['svm', 'svm'] },
+  ])('rejects malformed policy %j', (input) => {
+    expect(parseOjAssignmentPolicy(input)).toBeNull()
+  })
+
+  it('copies and freezes valid policy, with empty algorithm list explicitly unrestricted', () => {
+    const input = {
+      version: 1,
+      allowedTaskTypes: ['classification'],
+      allowedAlgorithms: [] as string[],
+    }
+    const policy = parseOjAssignmentPolicy(input)
+    expect(policy).not.toBeNull()
+    input.allowedTaskTypes.push('regression')
+    input.allowedAlgorithms.push('svm')
+    expect(policy?.allowedTaskTypes).toEqual(['classification'])
+    expect(policy?.allowedAlgorithms).toEqual([])
+    expect(Object.isFrozen(policy?.allowedTaskTypes)).toBe(true)
+    expect(ojAlgorithmPolicyIssue({ assignmentPolicy: policy }, 'svm', 'classification')).toBeNull()
+  })
+
+  it('keeps standalone behavior but fails closed for missing hosted policy', () => {
+    expect(ojTaskTypePolicyIssue(null, 'regression')).toBeNull()
+    expect(ojSubmissionPolicyIssue(null, projectFile().document)).toBeNull()
+    expect(ojTaskTypePolicyIssue({}, 'classification')).toContain('설정을 확인할 수 없습니다')
+    expect(ojSubmissionPolicyIssue({ assignmentPolicy: null }, projectFile().document)).toContain(
+      '다시 열어',
+    )
+  })
+
+  it('reports actual conflicts and allowed list without rewriting selections/history', () => {
+    const file = projectFile()
+    file.document.runs.experiments.push(
+      experiment('old-experiment', [run('old-run', { algorithm: 'random_forest' })]),
+    )
+    const before = JSON.stringify(file.document)
+    const issue = ojSubmissionPolicyIssue(policyHost(), file.document)
+    expect(issue).toContain('svm')
+    expect(issue).toContain('random_forest')
+    expect(issue).toContain('실험 old-experiment / 기록 old-run')
+    expect(issue).toContain('decision_tree')
+    expect(issue).toContain('과거 학습 기록')
+    expect(JSON.stringify(file.document)).toBe(before)
+  })
+
+  it('validates the current manifest and every old run even if selections are allowed', () => {
+    const file = projectFile()
+    file.document.settings.selectedAlgorithms = [{ algorithm: 'decision_tree' }]
+    expect(ojSubmissionPolicyIssue(policyHost(), file.document)).toBeNull()
+    file.document.runs.experiments.push(experiment('late', [run('late-run', { algorithm: 'svm' })]))
+    expect(ojSubmissionPolicyIssue(policyHost(), file.document)).toContain('svm')
+    file.document.manifest.taskType = 'regression'
+    expect(ojSubmissionPolicyIssue(policyHost(), file.document)).toContain('회귀 유형')
+    expect(
+      ojSelectionPolicyIssue(policyHost(), 'classification', [{ algorithm: 'knn' }]),
+    ).toContain('knn')
+  })
+
+  it('checks all history but bounds displayed conflict records and reports the total', () => {
+    const file = projectFile()
+    file.document.settings.selectedAlgorithms = [{ algorithm: 'decision_tree' }]
+    file.document.runs.experiments = Array.from({ length: 12 }, (_, index) =>
+      experiment(`old-${index}`, [run(`old-run-${index}`, { algorithm: 'svm' })]),
+    )
+    const issue = ojSubmissionPolicyIssue(policyHost(), file.document)
+    expect(issue).toContain('총 12건')
+    expect(issue).toContain('실험 old-7')
+    expect(issue).not.toContain('실험 old-8')
+    expect(issue).toContain('외 4건')
+    expect(file.document.runs.experiments).toHaveLength(12)
+  })
+
+  it('matches server history empty-ID handling without accepting a blank current selection', () => {
+    const file = projectFile()
+    file.document.settings.selectedAlgorithms = [{ algorithm: 'decision_tree' }]
+    file.document.runs.experiments.push(experiment('legacy', [run('empty', { algorithm: '' })]))
+    expect(ojSubmissionPolicyIssue(policyHost(), file.document)).toBeNull()
+    file.document.runs.experiments.push(
+      experiment('failed', [
+        run('failed-run', {
+          algorithm: 'unknown_algorithm',
+          status: 'failed',
+          metrics: undefined,
+          failure: { code: 'JOB_FAILED' },
+        }),
+      ]),
+    )
+    expect(ojSubmissionPolicyIssue(policyHost(), file.document)).toContain('unknown_algorithm')
+    expect(
+      ojSelectionPolicyIssue(
+        policyHost({
+          assignmentPolicy: {
+            version: 1,
+            allowedTaskTypes: ['classification'],
+            allowedAlgorithms: [],
+          },
+        }),
+        'classification',
+        [{ algorithm: '' }],
+      ),
+    ).toContain('빈 모델 ID')
+  })
+})
+
+describe('worker start policy guard', () => {
+  it('starts and completes a worker for an allowed hosted selection', async () => {
+    ojHostConfig.value = policyHost()
+    const finished = experiment('allowed-experiment', [run('allowed-run')])
+    const worker: TrainWorker = {
+      onmessage: null,
+      onerror: null,
+      terminate: vi.fn(),
+      postMessage: vi.fn(() => {
+        queueMicrotask(() =>
+          worker.onmessage?.({
+            data: {
+              type: 'done',
+              experiment: finished,
+              preprocessor: { format: 'fixture' },
+              models: new Map(),
+            },
+          } as unknown as MessageEvent<WorkerMessage>),
+        )
+      }),
+    }
+    const createWorker = vi.fn(() => worker)
+    const request = {
+      type: 'train',
+      input: {
+        taskType: 'classification',
+        settings: { selectedAlgorithms: [{ algorithm: 'decision_tree' }] },
+      },
+    } as TrainRequest
+    const training = useTraining(createWorker)
+    await expect(training.run(request)).resolves.toMatchObject({
+      experiment: { id: 'allowed-experiment' },
+    })
+    expect(createWorker).toHaveBeenCalledOnce()
+    expect(worker.postMessage).toHaveBeenCalledOnce()
+    expect(training.running.value).toBe(false)
+  })
+  it.each([
+    ['classification', ['svm']],
+    ['regression', ['decision_tree']],
+    [undefined, ['decision_tree']],
+  ])('rejects %s %j before creating a worker or progress state', async (taskType, algorithms) => {
+    ojHostConfig.value = policyHost()
+    const createWorker = vi.fn()
+    const training = useTraining(createWorker)
+    const request = {
+      type: 'train',
+      input: {
+        taskType,
+        settings: { selectedAlgorithms: algorithms.map((algorithm) => ({ algorithm })) },
+      },
+    } as TrainRequest
+    await expect(training.run(request)).rejects.toThrow()
+    expect(createWorker).not.toHaveBeenCalled()
+    expect(training.running.value).toBe(false)
+    expect(training.statuses.value).toEqual([])
+  })
+
+  it('rejects hosted training with missing policy', async () => {
+    ojHostConfig.value = policyHost({ assignmentPolicy: null })
+    const createWorker = vi.fn()
+    const request = {
+      type: 'train',
+      input: {
+        taskType: 'classification',
+        settings: { selectedAlgorithms: [{ algorithm: 'decision_tree' }] },
+      },
+    } as TrainRequest
+    await expect(useTraining(createWorker).run(request)).rejects.toThrow(
+      '설정을 확인할 수 없습니다',
+    )
+    expect(createWorker).not.toHaveBeenCalled()
+  })
+})

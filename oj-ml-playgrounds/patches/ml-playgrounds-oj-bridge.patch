@@ -0,0 +1,320 @@
+// @vitest-environment jsdom
+
+import { afterEach, expect, it, vi } from 'vitest'
+
+const SCOPE = 'HostEfGhIjKlMnOpQrStUvWx'
+const SESSION = 'SessionGhIjKlMnOpQrStUvWx'
+const KEY = 'AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8'
+
+const originalParent = window.parent
+let activeBridge: typeof import('../src/oj-host-v2') | null = null
+
+interface InstalledParent {
+  readonly value: Window
+  readonly postMessage: ReturnType<typeof vi.fn>
+}
+
+interface ConfiguredBridge {
+  readonly frameNonce: string
+  readonly parent: InstalledParent
+}
+
+function installParent(): InstalledParent {
+  const postMessage = vi.fn()
+  const value = { postMessage } as unknown as Window
+  Object.defineProperty(window, 'parent', { configurable: true, value })
+  return { value, postMessage }
+}
+
+function messages(parent: InstalledParent): Array<Record<string, unknown>> {
+  return parent.postMessage.mock.calls.map(([message]) => message as Record<string, unknown>)
+}
+
+function dispatchFromParent(parent: InstalledParent, data: Record<string, unknown>): void {
+  window.dispatchEvent(
+    new MessageEvent('message', {
+      data,
+      origin: window.location.origin,
+      source: parent.value,
+    }),
+  )
+}
+
+async function configureBridge(assignmentPolicy?: unknown): Promise<ConfiguredBridge> {
+  const parent = installParent()
+  const bridge = await import('../src/oj-host-v2')
+  activeBridge = bridge
+  const configured = bridge.initOjHostBridge()
+  const ready = messages(parent).find((message) => message.type === 'oj-ml:ready')
+  const frameNonce = ready?.frameNonce
+  expect(frameNonce).toMatch(/^[a-f0-9]{32}$/)
+  if (typeof frameNonce !== 'string') throw new Error('ready frame nonce missing')
+
+  dispatchFromParent(parent, {
+    type: 'oj-ml:configure',
+    version: 2,
+    frameNonce,
+    assignmentId: 'assignment-1',
+    attemptId: 'attempt-1',
+    restRoot: new URL('/wp-json/oj/v1', window.location.href).href,
+    nonce: 'wordpress-rest-nonce',
+    privacyUrl: new URL('/privacy', window.location.href).href,
+    storageScope: SCOPE,
+    storageSession: SESSION,
+    storageKey: KEY,
+    storageDatabase: `ml-playgrounds-oj-v1-${SCOPE}`,
+    storageKeyVersion: 1,
+    deviceMode: 'shared',
+    assignmentPolicy,
+  })
+  await expect(configured).resolves.toMatchObject({ storageScope: SCOPE, storageKey: KEY })
+  return { frameNonce, parent }
+}
+
+afterEach(() => {
+  activeBridge?.revokeOjHostBridge(false)
+  activeBridge = null
+  Object.defineProperty(window, 'parent', { configurable: true, value: originalParent })
+  vi.restoreAllMocks()
+  vi.resetModules()
+})
+
+it('configure validates assignment policy and retains invalid/missing policy as a fail-closed inline state', async () => {
+  await configureBridge({
+    version: 1,
+    allowedTaskTypes: ['classification'],
+    allowedAlgorithms: ['decision_tree'],
+  })
+  expect(activeBridge?.ojHostConfig.value?.assignmentPolicy).toEqual({
+    version: 1,
+    allowedTaskTypes: ['classification'],
+    allowedAlgorithms: ['decision_tree'],
+  })
+  activeBridge?.revokeOjHostBridge(false)
+  await configureBridge({ version: 2, allowedTaskTypes: ['classification'], allowedAlgorithms: [] })
+  expect(activeBridge?.ojHostConfig.value?.assignmentPolicy).toBeNull()
+  activeBridge?.revokeOjHostBridge(false)
+  await configureBridge()
+  expect(activeBridge?.ojHostConfig.value?.assignmentPolicy).toBeNull()
+})
+
+it('silent revoke는 config와 비밀값, frame nonce, wipe handler를 폐기한다', async () => {
+  const first = await configureBridge()
+  const bridge = activeBridge!
+  const wipe = vi.fn(async () => undefined)
+  bridge.registerOjStorageWipeHandler(wipe)
+
+  bridge.revokeOjHostBridge(false)
+
+  expect(bridge.ojHostConfig.value).toBeNull()
+  expect(messages(first.parent)).not.toContainEqual(
+    expect.objectContaining({ type: 'oj-ml:storage-revoked' }),
+  )
+  dispatchFromParent(first.parent, {
+    type: 'oj-ml:storage-wipe-request',
+    version: 2,
+    frameNonce: first.frameNonce,
+  })
+  await Promise.resolve()
+  expect(wipe).not.toHaveBeenCalled()
+
+  vi.resetModules()
+  activeBridge = null
+  const second = await configureBridge()
+  dispatchFromParent(second.parent, {
+    type: 'oj-ml:storage-wipe-request',
+    version: 2,
+    frameNonce: second.frameNonce,
+  })
+  await vi.waitFor(() =>
+    expect(messages(second.parent)).toContainEqual(
+      expect.objectContaining({
+        type: 'oj-ml:storage-error',
+        code: 'OJ_STORAGE_NOT_READY',
+        frameNonce: second.frameNonce,
+      }),
+    ),
+  )
+  expect(wipe).not.toHaveBeenCalled()
+})
+
+it('notifying revoke는 원래 frame nonce로 keyless storage-revoked만 보낸다', async () => {
+  const { frameNonce, parent } = await configureBridge()
+  const bridge = activeBridge!
+
+  bridge.revokeOjHostBridge(true)
+  bridge.revokeOjHostBridge(true)
+
+  const revoked = messages(parent).filter((message) => message.type === 'oj-ml:storage-revoked')
+  expect(revoked).toEqual([{ type: 'oj-ml:storage-revoked', version: 2, frameNonce }])
+  expect(Object.keys(revoked[0]!).sort()).toEqual(['frameNonce', 'type', 'version'])
+  expect(JSON.stringify(revoked)).not.toContain(KEY)
+  expect(JSON.stringify(revoked)).not.toContain('wordpress-rest-nonce')
+  expect(bridge.ojHostConfig.value).toBeNull()
+})
+
+it.each([
+  ['success', 'oj-ml:storage-wiped', undefined],
+  ['failure', 'oj-ml:storage-error', 'OJ_STORAGE_WIPE_FAILED'],
+] as const)(
+  'local wipe %s ACK는 handler 내부 revoke 뒤에도 요청 시 캡처한 frame nonce를 쓴다',
+  async (outcome, responseType, code) => {
+    const { frameNonce, parent } = await configureBridge()
+    const bridge = activeBridge!
+    bridge.registerOjStorageWipeHandler(async () => {
+      bridge.revokeOjHostBridge(false)
+      if (outcome === 'failure') throw new Error('wipe failed')
+    })
+
+    dispatchFromParent(parent, {
+      type: 'oj-ml:storage-wipe-request',
+      version: 2,
+      frameNonce,
+    })
+
+    await vi.waitFor(() =>
+      expect(messages(parent)).toContainEqual(
+        expect.objectContaining({
+          type: responseType,
+          frameNonce,
+          ...(code === undefined ? {} : { code }),
+        }),
+      ),
+    )
+    expect(bridge.ojHostConfig.value).toBeNull()
+    const response = messages(parent).find((message) => message.type === responseType)
+    expect(JSON.stringify(response)).not.toContain(KEY)
+  },
+)
+
+function portfolioRequest(frameNonce: string): Record<string, unknown> {
+  return {
+    type: 'oj-ml:portfolio-template-apply',
+    version: 2,
+    frameNonce,
+    assignmentId: 'assignment-1',
+    storageSession: SESSION,
+    requestId: 'request_1234567890',
+    projectId: 'project-1',
+    projectToken: 'project-token',
+    template: { sections: [{ id: 'question-1', title: '문제 정의' }] },
+  }
+}
+
+it('portfolio request verifies origin, source, nonce, assignment and storage session', async () => {
+  const { frameNonce, parent } = await configureBridge()
+  const handler = vi.fn(async () => ({ state: 'applied' as const, added: 1 }))
+  activeBridge!.registerOjPortfolioHandler(handler)
+  const request = portfolioRequest(frameNonce)
+  for (const [field, value] of [
+    ['frameNonce', 'a'.repeat(32)],
+    ['assignmentId', 'other-assignment'],
+    ['storageSession', 'other-session'],
+    ['version', 1],
+  ])
+    dispatchFromParent(parent, { ...request, [field as string]: value })
+  window.dispatchEvent(
+    new MessageEvent('message', {
+      data: request,
+      origin: 'https://evil.example',
+      source: parent.value,
+    }),
+  )
+  window.dispatchEvent(
+    new MessageEvent('message', { data: request, origin: window.location.origin, source: window }),
+  )
+  await Promise.resolve()
+  expect(handler).not.toHaveBeenCalled()
+  dispatchFromParent(parent, request)
+  await vi.waitFor(() => expect(handler).toHaveBeenCalledTimes(1))
+  await vi.waitFor(() =>
+    expect(messages(parent)).toContainEqual(
+      expect.objectContaining({
+        type: 'oj-ml:portfolio-template-result',
+        state: 'applied',
+        added: 1,
+        requestId: request.requestId,
+        projectId: request.projectId,
+        projectToken: request.projectToken,
+        assignmentId: 'assignment-1',
+        storageSession: SESSION,
+        frameNonce,
+      }),
+    ),
+  )
+})
+
+it('portfolio duplicate messages share one pending operation and reject modified request IDs', async () => {
+  const { frameNonce, parent } = await configureBridge()
+  let finish!: (value: { state: 'applied'; added: number }) => void
+  const handler = vi.fn(
+    () =>
+      new Promise<{ state: 'applied'; added: number }>((resolve) => {
+        finish = resolve
+      }),
+  )
+  activeBridge!.registerOjPortfolioHandler(handler)
+  const request = portfolioRequest(frameNonce)
+  dispatchFromParent(parent, request)
+  dispatchFromParent(parent, request)
+  dispatchFromParent(parent, { ...request, projectId: 'project-2' })
+  dispatchFromParent(parent, { ...request, requestId: 'another_request_1234567890' })
+  await vi.waitFor(() => expect(handler).toHaveBeenCalledTimes(1))
+  expect(messages(parent)).toContainEqual(
+    expect.objectContaining({ code: 'OJ_PORTFOLIO_REQUEST_CONFLICT' }),
+  )
+  expect(messages(parent)).toContainEqual(expect.objectContaining({ code: 'OJ_PORTFOLIO_BUSY' }))
+  finish({ state: 'applied', added: 1 })
+  await vi.waitFor(() =>
+    expect(messages(parent).filter((message) => message.state === 'applied')).toHaveLength(2),
+  )
+  dispatchFromParent(parent, request)
+  await vi.waitFor(() =>
+    expect(messages(parent).filter((message) => message.state === 'applied')).toHaveLength(3),
+  )
+  expect(handler).toHaveBeenCalledTimes(1)
+})
+
+it('portfolio revoke during persistence suppresses late replies and removes the handler', async () => {
+  const { frameNonce, parent } = await configureBridge()
+  let finish!: (value: { state: 'applied'; added: number }) => void
+  const handler = vi.fn(
+    () =>
+      new Promise<{ state: 'applied'; added: number }>((resolve) => {
+        finish = resolve
+      }),
+  )
+  activeBridge!.registerOjPortfolioHandler(handler)
+  dispatchFromParent(parent, portfolioRequest(frameNonce))
+  await vi.waitFor(() => expect(handler).toHaveBeenCalledTimes(1))
+  activeBridge!.revokeOjHostBridge(false)
+  finish({ state: 'applied', added: 1 })
+  await Promise.resolve()
+  await Promise.resolve()
+  await Promise.resolve()
+  expect(
+    messages(parent).filter((message) => message.type === 'oj-ml:portfolio-template-result'),
+  ).toHaveLength(0)
+  dispatchFromParent(parent, portfolioRequest(frameNonce))
+  await Promise.resolve()
+  expect(handler).toHaveBeenCalledTimes(1)
+})
+
+it('portfolio rejects missing handlers and invalid answer-bearing payloads without execution', async () => {
+  const { frameNonce, parent } = await configureBridge()
+  const request = portfolioRequest(frameNonce)
+  dispatchFromParent(parent, request)
+  expect(messages(parent)).toContainEqual(
+    expect.objectContaining({ code: 'OJ_PORTFOLIO_NOT_READY' }),
+  )
+  const handler = vi.fn(async () => ({ state: 'applied' as const, added: 1 }))
+  activeBridge!.registerOjPortfolioHandler(handler)
+  dispatchFromParent(parent, {
+    ...request,
+    template: { sections: [{ id: 'x', title: 'x' }], answers: { x: 'forbidden' } },
+  })
+  expect(messages(parent)).toContainEqual(
+    expect.objectContaining({ code: 'OJ_PORTFOLIO_TEMPLATE_INVALID' }),
+  )
+  expect(handler).not.toHaveBeenCalled()
+})
diff --git a/frontend/tests/oj-portfolio-template.spec.ts b/frontend/tests/oj-portfolio-template.spec.ts

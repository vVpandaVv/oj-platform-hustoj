new file mode 100644
index 0000000000000000000000000000000000000000..d6df97f6f87aed3b9ab7c071e15ada94255347de
--- /dev/null
+++ b/frontend/tests/oj-public-pc-broadcast.spec.ts
@@ -0,0 +1,117 @@
+// @vitest-environment jsdom
+
+import 'fake-indexeddb/auto'
+
+import { afterEach, expect, it, vi } from 'vitest'
+
+import { isClientError } from '../src/errors'
+import {
+  acquireOjStorageLease,
+  configureOjStorageScope,
+  isOjStorageScopeRevoked,
+  ojStorageControlChannelName,
+  ojStorageLockName,
+  ojStorageRevokeMessage,
+  registerOjStorageRevokeHandler,
+  withOjStorageOperation,
+} from '../src/oj-storage-scope'
+import { saveProject } from '../src/project/storage'
+import { deferred, MockBroadcastChannel, MockLockManager } from './fixtures/oj-storage'
+import { projectFile } from './fixtures/project'
+
+const SCOPE = 'BroadEfGhIjKlMnOpQrStUvWx'
+const KEY = 'AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8'
+
+afterEach(() => {
+  MockBroadcastChannel.reset()
+  vi.restoreAllMocks()
+  vi.unstubAllGlobals()
+  Object.defineProperty(navigator, 'locks', { configurable: true, value: undefined })
+})
+
+it('외부 revoke를 받은 탭은 handler, active operation, DB close 뒤 shared lease를 해제한다', async () => {
+  const sequence: string[] = []
+  const locks = new MockLockManager(sequence)
+  MockBroadcastChannel.reset()
+  vi.stubGlobal('BroadcastChannel', MockBroadcastChannel)
+  Object.defineProperty(navigator, 'locks', { configurable: true, value: locks })
+
+  const nativeClose = IDBDatabase.prototype.close
+  vi.spyOn(IDBDatabase.prototype, 'close').mockImplementation(function (this: IDBDatabase) {
+    sequence.push('database:close')
+    nativeClose.call(this)
+  })
+
+  configureOjStorageScope(SCOPE, KEY)
+  await acquireOjStorageLease()
+  await saveProject(projectFile())
+
+  const handlerStarted = deferred<void>()
+  const handlerRelease = deferred<void>()
+  const handlerFinished = deferred<void>()
+  const unregister = registerOjStorageRevokeHandler(async () => {
+    sequence.push('handler:start')
+    handlerStarted.resolve(undefined)
+    await handlerRelease.promise
+    sequence.push('handler:finished')
+    handlerFinished.resolve(undefined)
+  })
+
+  const operationStarted = deferred<void>()
+  const operationRelease = deferred<void>()
+  const activeOperation = withOjStorageOperation(async (checkpoint) => {
+    sequence.push('operation:start')
+    operationStarted.resolve(undefined)
+    try {
+      await operationRelease.promise
+      checkpoint()
+    } finally {
+      sequence.push('operation:finished')
+    }
+  }).catch((error: unknown) => error)
+  await operationStarted.promise
+
+  const lockName = ojStorageLockName(SCOPE)
+  const exclusive = locks.request(lockName, { mode: 'exclusive' }, () => {
+    sequence.push('exclusive:callback')
+  })
+  expect(locks.isPending(lockName, 'exclusive')).toBe(true)
+
+  const sender = new MockBroadcastChannel(ojStorageControlChannelName(SCOPE))
+  const message = ojStorageRevokeMessage(SCOPE)
+  sender.postMessage(message)
+  await handlerStarted.promise
+  await vi.waitFor(() => expect(sequence).toContain('database:close'))
+
+  expect(isOjStorageScopeRevoked()).toBe(true)
+  expect(locks.isHeld(lockName, 'shared')).toBe(true)
+  expect(sequence).not.toContain('exclusive:callback')
+  expect(MockBroadcastChannel.sent).toEqual([
+    { channel: ojStorageControlChannelName(SCOPE), data: message },
+  ])
+  expect(Object.keys(message).sort()).toEqual(['scope', 'type', 'version'])
+  expect(JSON.stringify(message)).not.toContain(KEY)
+
+  handlerRelease.resolve(undefined)
+  await handlerFinished.promise
+  await Promise.resolve()
+  expect(locks.isHeld(lockName, 'shared')).toBe(true)
+  expect(sequence).not.toContain('exclusive:callback')
+
+  operationRelease.resolve(undefined)
+  const operationFailure = await activeOperation
+  expect(isClientError(operationFailure) && operationFailure.code).toBe('STORAGE_LOCKED')
+  await exclusive
+
+  const sharedRelease = sequence.indexOf(`lock:${lockName}:released:shared`)
+  const exclusiveAcquire = sequence.indexOf(`lock:${lockName}:acquired:exclusive`)
+  expect(sequence.indexOf('database:close')).toBeLessThan(sharedRelease)
+  expect(sequence.indexOf('handler:finished')).toBeLessThan(sharedRelease)
+  expect(sequence.indexOf('operation:finished')).toBeLessThan(sharedRelease)
+  expect(sharedRelease).toBeLessThan(exclusiveAcquire)
+
+  const futureFailure = await saveProject(projectFile()).catch((error: unknown) => error)
+  expect(isClientError(futureFailure) && futureFailure.code).toBe('STORAGE_LOCKED')
+  unregister()
+  sender.close()
+})

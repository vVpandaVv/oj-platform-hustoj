diff --git a/frontend/src/project/delete-database.ts b/frontend/src/project/delete-database.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0988b5a42180153152ec203bfd961f3d4810843a
--- /dev/null
+++ b/frontend/src/project/delete-database.ts
@@ -0,0 +1,41 @@
+import { ClientError } from '../errors'
+
+/**
+ * idb의 deleteDB는 `blocked` callback이 던져도 반환 Promise를 reject하지 않는다.
+ * 공용 PC 삭제 UI가 무한 대기하지 않도록 native request를 명시적으로 정착시킨다.
+ */
+function deleteDatabase(name: string, waitForBlocked: boolean): Promise<void> {
+  return new Promise<void>((resolve, reject) => {
+    let request: IDBOpenDBRequest
+    try {
+      request = window.indexedDB.deleteDatabase(name)
+    } catch (error) {
+      reject(error)
+      return
+    }
+
+    let settled = false
+    const finish = (callback: () => void) => {
+      if (settled) return
+      settled = true
+      callback()
+    }
+    request.addEventListener('success', () => finish(resolve))
+    request.addEventListener('error', () =>
+      finish(() => reject(request.error ?? new ClientError('STORAGE_DELETE_BLOCKED'))),
+    )
+    request.addEventListener('blocked', () => {
+      if (!waitForBlocked) finish(() => reject(new ClientError('STORAGE_DELETE_BLOCKED')))
+    })
+  })
+}
+
+/** Fails fast on blocked for bootstrap cleanup paths that have no outer liveness timeout. */
+export function deleteDatabaseStrict(name: string): Promise<void> {
+  return deleteDatabase(name, false)
+}
+
+/** Keeps the caller's exclusive lock until IndexedDB reports success or error. */
+export function deleteDatabaseUntilSettled(name: string): Promise<void> {
+  return deleteDatabase(name, true)
+}

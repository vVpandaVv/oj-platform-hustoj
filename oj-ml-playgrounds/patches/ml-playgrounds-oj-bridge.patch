+
+function deferred() {
+  let resolve!: () => void
+  let reject!: (reason: Error) => void
+  const promise = new Promise<void>((done, fail) => {
+    resolve = done
+    reject = fail
+  })
+  return { promise, resolve, reject }
+}
+
+function snapshot(name: string, projectId = 'project-1') {
+  const file = projectFile()
+  file.document.manifest.name = name
+  file.document.manifest.projectId = projectId
+  return file
+}

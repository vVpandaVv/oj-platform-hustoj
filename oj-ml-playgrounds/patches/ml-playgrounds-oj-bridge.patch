+      expect(wrapper.findAll('tbody td')).toHaveLength(tables * (kind === 'linear' ? 420 : 400))
+      const pagers = wrapper.findAllComponents(ResultPager)
+      await pagers[0]!.findAll('button')[3]!.trigger('click')
+      await pagers[1]!.findAll('button')[3]!.trigger('click')
+      expect(wrapper.find('tbody th').text()).toBe('feature-40')
+      expect(
+        wrapper
+          .findAll('thead th')
+          .slice(1, 3)
+          .map((cell) => cell.text()),
+      ).toEqual(['class-40', 'class-41'])
+      expect(
+        wrapper
+          .find('tbody tr')
+          .findAll('td')
+          .map((cell) => cell.text()),
+      ).toEqual(['1,680', '1,721'])
+      if (kind === 'linear')
+        expect(
+          wrapper
+            .findAll('tbody tr')
+            .at(-1)!
+            .findAll('td')
+            .map((cell) => cell.text()),
+        ).toEqual(['1', '1'])
+      await wrapper.setProps({
+        input: { ...input, experiment: { ...input.experiment, id: 'new-experiment' } },
+      })
+      expect(wrapper.find('tbody th').text()).toBe('feature-0')
+      expect(wrapper.findAll('thead th')[1]!.text()).toBe('class-0')
+    },
+  )
+
+  it.each([
+    [2166, 2],
+    [2, 2166],
+  ])('bounds a model with %i features and %i classes', (features, classes) => {
+    const wrapper = mount(ParameterPanel, {
+      props: { input: parameterInput(features, classes, 'bayes') },
+      global: { plugins: [i18n] },
+    })
+    mounted.push(wrapper)
+    expect(wrapper.findAll('tbody td')).toHaveLength(80)
+    expect(wrapper.findAll('*').length).toBeLessThan(250)
+  })
+})

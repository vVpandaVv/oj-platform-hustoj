+    expect(wrapper.find('tbody th').text()).toBe('class-0')
+  })
+
+  it('clears cell details when either axis changes and repeated navigation never grows the DOM', async () => {
+    const wrapper = mount(ConfusionMatrixPanel, {
+      props: { input: classificationInput(51) },

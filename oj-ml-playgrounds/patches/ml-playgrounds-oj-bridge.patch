+    for (let iteration = 0; iteration < 10; iteration += 1) {
+      await wrapper.find('tbody button').trigger('click')
+      expect(wrapper.findAll('dd')).toHaveLength(3)
+      await pager.findAll('button')[2]!.trigger('click')
+      expect(wrapper.findAll('dd')).toHaveLength(0)
+      expect(wrapper.findAll('tbody td').length).toBeLessThanOrEqual(400)
+      await pager.findAll('button')[0]!.trigger('click')
+    }
+    expect(wrapper.findAll('*').length).toBeLessThan(1000)
+  })
+
+  it('explains omitted large matrices without generating a replacement matrix', () => {
+    const input = classificationInput(51)
+    delete input.run.confusionMatrix
+    const wrapper = mount(ConfusionMatrixPanel, { props: { input }, global: { plugins: [i18n] } })
+    mounted.push(wrapper)
+    expect(wrapper.text()).toContain('confusion matrix')
+    expect(wrapper.text()).toContain('per-class')
+    expect(wrapper.findAll('table')).toHaveLength(0)
+    expect(input.run.confusionMatrix).toBeUndefined()
+  })
+
+  it('pages all 2166 per-class scores without altering their full-data values', async () => {
+    const input = classificationInput(2166)
+    const wrapper = mount(PerClassPanel, { props: { input }, global: { plugins: [i18n] } })
+    mounted.push(wrapper)
+    expect(wrapper.findAll('tbody tr')).toHaveLength(20)
+    const pager = wrapper.findComponent(ResultPager)
+    await pager.findAll('button')[3]!.trigger('click')
+    expect(wrapper.findAll('tbody tr')).toHaveLength(6)
+    expect(wrapper.findAll('tbody th').at(-1)!.text()).toBe('class-2165')
+    expect(wrapper.findAll('tbody td').at(-1)!.text()).toBe('2')
+    expect(input.run.perClass).toHaveLength(2166)
+    await wrapper.setProps({ input: { ...input, run: { ...input.run, id: 'new-run' } } })
+    expect(wrapper.find('tbody th').text()).toBe('class-0')
+  })
+
+  it.each(['linear', 'bayes'] as const)(
+    'bounds both parameter axes for %s and keeps final values and intercepts',
+    async (kind) => {
+      const input = parameterInput(41, 42, kind)
+      const wrapper = mount(ParameterPanel, { props: { input }, global: { plugins: [i18n] } })
+      mounted.push(wrapper)

+<template>
+  <nav class="flex flex-wrap items-center gap-2" :aria-label="props.label">
+    <span class="font-bold text-ink-soft">{{ props.label }}</span>
+    <span aria-live="polite" class="tabular-nums text-ink-soft">
+      {{
+        t('results.pageRange', {
+          start: props.window.total === 0 ? 0 : props.window.start + 1,
+          end: props.window.end,
+          total: props.window.total,
+          page: props.window.page + 1,
+          pages: props.window.pages,
+        })
+      }}
+    </span>
+    <AppButton variant="subtle" :disabled="!props.window.hasPrevious" @click="emit('page', 0)">
+      {{ t('results.pageFirst') }}
+    </AppButton>
+    <AppButton
+      variant="subtle"
+      :disabled="!props.window.hasPrevious"
+      @click="emit('page', props.window.page - 1)"
+    >
+      {{ t('results.pagePrevious') }}
+    </AppButton>
+    <AppButton
+      variant="subtle"
+      :disabled="!props.window.hasNext"
+      @click="emit('page', props.window.page + 1)"
+    >
+      {{ t('results.pageNext') }}
+    </AppButton>
+    <AppButton
+      variant="subtle"
+      :disabled="!props.window.hasNext"
+      @click="emit('page', props.window.pages - 1)"
+    >
+      {{ t('results.pageLast') }}
+    </AppButton>
+  </nav>
+</template>

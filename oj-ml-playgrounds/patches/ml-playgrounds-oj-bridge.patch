+    expect(wrapper.findAll('dd')).toHaveLength(0)
+  })
+
+  it('bounds a 2166-class legacy matrix to 400 cells while reaching both final axes unchanged', async () => {
+    const input = classificationInput(2166)
+    const original = input.run.confusionMatrix
+    const wrapper = mount(ConfusionMatrixPanel, { props: { input }, global: { plugins: [i18n] } })
+    mounted.push(wrapper)

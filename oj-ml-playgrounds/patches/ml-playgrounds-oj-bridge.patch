+const mounted: VueWrapper[] = []
+beforeEach(async () => {
+  await setLocale('en')
+})
+afterEach(() => {
+  mounted.splice(0).forEach((wrapper) => wrapper.unmount())
+})
+
+function inputFor(result: Run): PanelInput {
+  return {
+    run: result,
+    experiment: experiment('experiment-a', [result]),
+    dataset: null,
+    preprocessor: null,
+    modelBytes: undefined,
+  }
+}
+
+function classificationInput(count: number): PanelInput {
+  const labels = Array.from({ length: count }, (_, index) => `class-${index}`)
+  // This is a complete logical dense matrix, but shares immutable zero rows to
+  // avoid making the regression test itself allocate millions of distinct cells.
+  const shared = Array<number>(count).fill(0)
+  shared[0] = 7
+  Object.freeze(shared)
+  const matrix = Array.from({ length: count }, () => shared)
+  const last = [...shared]
+  last[count - 1] = 31
+  Object.freeze(last)
+  matrix[count - 1] = last
+  Object.freeze(matrix)
+  return inputFor(
+    run('run-a', {
+      confusionMatrix: { labels, matrix },
+      perClass: labels.map((label) => ({
+        label,
+        precision: 1,
+        recall: 1,
+        specificity: 1,
+        f1: 1,
+        support: 2,
+      })),
+    }),
+  )
+}
+
+function parameterInput(features: number, classes: number, kind: 'linear' | 'bayes'): PanelInput {
+  const names = Array.from({ length: features }, (_, index) => `feature-${index}`)
+  const labels = Array.from({ length: classes }, (_, index) => `class-${index}`)
+  const values = labels.map((_, row) => names.map((_, column) => row * features + column))
+  const format = kind === 'linear' ? 'mlpx-linear-v2' : 'mlpx-naive-bayes-v1'
+  const model =
+    kind === 'linear'
+      ? {
+          format,
+          classes: labels,
+          featureCount: features,
+          weights: values,
+          intercepts: labels.map(() => 1),
+        }
+      : {
+          format,
+          classes: labels,
+          featureCount: features,
+          means: values,
+          variances: values,
+          logPriors: labels.map(() => -1),
+        }
+  const input = inputFor(
+    run('run-parameters', {
+      algorithm: kind === 'linear' ? 'logistic_regression' : 'naive_bayes',
+      model: { format, path: 'model/parameters.json', sizeBytes: 1, includesPreprocessing: true },
+    }),
+  )
+  return {
+    ...input,
+    modelBytes: new TextEncoder().encode(JSON.stringify(model)),
+    preprocessor: {
+      format: 'mlpx-preprocess-v1',
+      columns: names.map((name) => ({ name, kind: 'numeric' })),
+      featureNames: names,
+      excludedColumns: [],
+    },
+  }
+}
+
+describe('bounded result windows', () => {
+  it('covers every entry with bounded allocations and clamps stale page positions', () => {
+    const total = 2166
+    const collected: number[] = []
+    for (let page = 0; page < resultWindow(total, 0).pages; page += 1) {
+      const indices = resultIndices(resultWindow(total, page))
+      expect(indices.length).toBeLessThanOrEqual(RESULTS_TABLE_PAGE_SIZE)
+      collected.push(...indices)
+    }
+    expect(collected).toEqual(Array.from({ length: total }, (_, index) => index))
+    expect(resultWindow(2, 108)).toMatchObject({ page: 0, start: 0, end: 2, hasNext: false })
+    expect(resultIndices(resultWindow(0, 100))).toEqual([])
+  })
+
+  it('keeps small confusion counts and opens one keyboard-accessible detail without cell popovers', async () => {

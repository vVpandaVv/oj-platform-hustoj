+} from '../src/oj-storage-scope'
+import {
+  closeStorage,
+  deleteCurrentStorage,
+  listProjects,
+  loadProject,
+  saveProject,
+} from '../src/project/storage'
+import { newProjectDocument, newProjectSeed } from '../src/project/create'
+import { indexedDatabaseNames, MockBroadcastChannel, MockLockManager } from './fixtures/oj-storage'
+
+const SCOPE = 'AbCdEfGhIjKlMnOpQrStUvWx'
+const KEY = 'AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8'
+const locks = new MockLockManager()
+
+beforeAll(async () => {
+  vi.stubGlobal('BroadcastChannel', MockBroadcastChannel)
+  Object.defineProperty(navigator, 'locks', { configurable: true, value: locks })
+  configureOjStorageScope(SCOPE, KEY)
+  await acquireOjStorageLease()
+})
+
+afterAll(() => {
+  closeStorage()
+  MockBroadcastChannel.reset()
+  vi.unstubAllGlobals()
+  Object.defineProperty(navigator, 'locks', { configurable: true, value: undefined })
+})
+
+describe('OJ 공용 PC 암호화 저장소', () => {
+  it('scope마다 독립된 불투명 DB 이름을 사용한다', () => {
+    expect(scopedDatabaseName('ml-playgrounds')).toBe(`ml-playgrounds-oj-v1-${SCOPE}`)
+  })
+
+  it('화면 설정도 현재 사용자 scope로 분리한다', () => {
+    expect(scopedLocalStorageKey('ml-playgrounds:theme')).toBe(`ml-playgrounds:theme:oj:${SCOPE}`)
+  })
+
+  it('AES-GCM 봉인은 평문을 남기지 않고 변조를 거부한다', async () => {
+    const plaintext = new TextEncoder().encode('student-private-dataset')
+    const sealed = await sealBytes(plaintext, 'test-payload')
+    expect(new TextDecoder().decode(sealed.ciphertext)).not.toContain('student-private-dataset')
+    await expect(openBytes(sealed, 'test-payload').then(Array.from)).resolves.toEqual(
+      Array.from(plaintext),
+    )
+
+    const tampered = { ...sealed, ciphertext: sealed.ciphertext.slice() }
+    tampered.ciphertext[0] = (tampered.ciphertext[0] ?? 0) ^ 1
+    const thrown = await openBytes(tampered, 'test-payload').catch((error: unknown) => error)
+    expect(isClientError(thrown) && thrown.code).toBe('STORAGE_LOCKED')
+  })
+
+  it('프로젝트를 왕복하지만 IndexedDB 원문에는 이름과 데이터가 없다', async () => {
+    const document = newProjectDocument(
+      { name: '학생A 비밀 프로젝트', locale: 'ko', dataType: 'tabular' },
+      newProjectSeed(),
+    )
+    const dataset = new TextEncoder().encode('name,score\nstudent-a,99\n')
+    document.settings.data.dataset = {
+      path: 'dataset/train.csv',
+      originalFileName: 'train.csv',
+      hasHeader: true,
+      encoding: 'utf-8',
+    }
+    await saveProject({
+      document,
+      dataset: { bytes: dataset, hash: 'test-hash' },
+      models: new Map([['model/private.bin', new Uint8Array([1, 2, 3, 4])]]),
+      images: new Map(),
+      attachments: new Map(),
+      embeddings: new Map(),
+    })
+
+    const loaded = await loadProject(document.manifest.projectId)
+    expect(loaded?.document.manifest.name).toBe('학생A 비밀 프로젝트')
+    expect(new TextDecoder().decode(loaded?.dataset?.bytes)).toContain('student-a')
+    expect(await listProjects()).toHaveLength(1)
+
+    const database = await openDB(scopedDatabaseName('ml-playgrounds'), 1)
+    const rawProject = await database.get('projects', document.manifest.projectId)
+    const rawDataset = await database.get('datasets', document.manifest.projectId)
+    const rawModels = await database.getAll('models')
+    database.close()
+    const raw = JSON.stringify([rawProject, rawDataset, rawModels])
+    expect(raw).not.toContain('학생A 비밀 프로젝트')
+    expect(raw).not.toContain('student-a')
+    expect(raw).not.toContain('model/private.bin')
+  })
+
+  it('현재 scope 전체 삭제는 terminal revoke로 남고 standalone 저장소로 떨어지지 않는다', async () => {
+    const preferenceKey = scopedLocalStorageKey('ml-playgrounds:theme')
+    const databaseName = scopedDatabaseName('ml-playgrounds')
+    window.localStorage.setItem(preferenceKey, 'dark')
+
+    await deleteCurrentStorage()
+
+    expect(hasOjStorageScope()).toBe(true)
+    expect(isOjStorageScopeRevoked()).toBe(true)
+    const thrown = await listProjects().catch((error: unknown) => error)
+    expect(isClientError(thrown) && thrown.code).toBe('STORAGE_LOCKED')
+    expect(window.localStorage.getItem(preferenceKey)).toBeNull()
+    expect(await indexedDatabaseNames()).not.toContain(databaseName)
+    expect(await indexedDatabaseNames()).not.toContain('ml-playgrounds')
+  })
+})

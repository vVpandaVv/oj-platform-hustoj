+      classificationMemoryNotice({
+        dataset: { ...data, rows },
+        settings: current,
+        taskType: 'classification',
+      }),
+    ).toEqual({ target: 'target', classes: 52, numeric: false })
+  })
+
+  it('matches the actual plan sampling and includes provided-test-only categories', () => {
+    const data = dataset(2166, 8760)
+    const current = settings()
+    current.nSamples = 70
+    const plan = planRun({
+      dataset: data,
+      testDataset: null,
+      settings: current,
+      taskType: 'classification',
+    })
+    expect(plan.ok).toBe(true)
+    if (!plan.ok) return
+    expect(
+      classificationMemoryNotice({ dataset: data, settings: current, taskType: 'classification' })
+        ?.classes,
+    ).toBe(new Set(plan.labels).size)
+    current.split.method = 'provided'
+    current.nSamples = undefined
+    const supplied = dataset(51)
+    expect(
+      classificationMemoryNotice({
+        dataset: dataset(2),
+        testDataset: supplied,
+        settings: current,
+        taskType: 'classification',
+      })?.classes,
+    ).toBe(51)
+    current.split.method = 'holdout'
+    expect(
+      classificationMemoryNotice({
+        dataset: dataset(2),
+        testDataset: supplied,
+        settings: current,
+        taskType: 'classification',
+      }),
+    ).toBeNull()
+  })
+
+  it('does not warn for small classification, regression, clustering or absent target', () => {
+    const current = settings()
+    expect(
+      classificationMemoryNotice({
+        dataset: dataset(50),
+        settings: current,
+        taskType: 'classification',
+      }),
+    ).toBeNull()
+    for (const taskType of ['regression', 'clustering', undefined] as const) {
+      expect(
+        classificationMemoryNotice({ dataset: dataset(2166), settings: current, taskType }),
+      ).toBeNull()
+    }
+    current.data = { ...dataSettings('tabular', current), target: undefined }
+    expect(
+      classificationMemoryNotice({
+        dataset: dataset(2166),
+        settings: current,
+        taskType: 'classification',
+      }),
+    ).toBeNull()
+  })
+
+  it('invalidates confirmation on changed data, target or training settings, but not results', () => {
+    const file = projectFile()
+    const initial = classificationConfirmationKey(file)
+    file.document.manifest.updatedAt = '2026-10-15T00:00:00Z'
+    expect(classificationConfirmationKey(file)).toBe(initial)
+    file.document.settings.data = {
+      ...dataSettings('tabular', file.document.settings),
+      target: 'new-target',
+    }
+    expect(classificationConfirmationKey(file)).not.toBe(initial)
+    const targetKey = classificationConfirmationKey(file)
+    file.dataset = { ...file.dataset!, hash: 'new-data-hash' }
+    expect(classificationConfirmationKey(file)).not.toBe(targetKey)
+    const dataKey = classificationConfirmationKey(file)
+    file.document.settings.selectedAlgorithms = [{ algorithm: 'logistic_regression' }]

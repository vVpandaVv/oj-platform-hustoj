+// @vitest-environment jsdom
+import { flushPromises, shallowMount, type VueWrapper } from '@vue/test-utils'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { nextTick, ref, shallowReactive } from 'vue'
+import AppButton from '../src/components/AppButton.vue'
+import AppDialog from '../src/components/AppDialog.vue'
+import type { TrainingProgress } from '../src/composables/useTraining'
+import { hashBytes } from '../src/hash'
+import { i18n, setLocale } from '../src/i18n'
+import type { ExperimentResult } from '../src/ml/experiment'
+import type { ModelStatus } from '../src/ml/training-status'
+import type { TrainRequest } from '../src/ml/worker/protocol'
+import { ojHostConfig } from '../src/oj-host-v2'
+import type { ProjectFile } from '../src/project/format'
+import { dataSettings } from '../src/project/schema'
+import TrainView from '../src/views/TrainView.vue'
+import { policyHost } from './fixtures/oj-assignment-policy'
+import { projectFile } from './fixtures/project'
+
+const store = shallowReactive({
+  file: null as ProjectFile | null,
+  get taskType() {
+    return this.file?.document.manifest.taskType
+  },
+  update: vi.fn((next: ProjectFile) => {
+    store.file = next
+  }),
+})
+const training = {
+  progress: ref<TrainingProgress | null>(null),
+  statuses: ref<readonly ModelStatus[]>([]),
+  running: ref(false),
+  run: vi.fn<(_request: TrainRequest) => Promise<ExperimentResult | null>>(),
+  cancel: vi.fn(),
+}
+vi.mock('../src/stores/project', () => ({ useProjectStore: () => store }))
+vi.mock('../src/composables/useTraining', () => ({ useTraining: () => training }))
+vi.mock('../src/stores/toasts', () => ({
+  useToastStore: () => ({ push: vi.fn(), pushError: vi.fn() }),
+}))
+vi.mock('../src/ml/worker/spawn', () => ({ spawnTrainingWorker: vi.fn() }))
+vi.mock('vue-router', () => ({ onBeforeRouteLeave: vi.fn(), useRouter: () => ({ push: vi.fn() }) }))
+
+const mounted: VueWrapper[] = []
+const selectedAlgorithms = [
+  { algorithm: 'decision_tree' },
+  { algorithm: 'logistic_regression' },
+  { algorithm: 'naive_bayes' },
+]
+
+/** The reported classroom shape, without copying any student's original data. */
+function numericProject(classes = 2166): ProjectFile {
+  const file = projectFile()
+  const features = Array.from({ length: 13 }, (_, index) => `x${index + 1}`)
+  const rows = Array.from({ length: 8760 }, (_, index) =>
+    [...features.map((_, column) => String((index + column) % 31)), String(index % classes)].join(
+      ',',
+    ),
+  )
+  const bytes = new TextEncoder().encode([[...features, 'target'].join(','), ...rows].join('\n'))
+  file.dataset = { bytes, hash: hashBytes(bytes) }
+  file.document.settings = {
+    ...file.document.settings,
+    data: {
+      ...dataSettings('tabular', file.document.settings),
+      features,
+      target: 'target',
+    },
+    selectedAlgorithms: structuredClone(selectedAlgorithms),
+  }
+  file.document.runs = { experiments: [] }
+  return file
+}
+
+function trainView() {
+  const wrapper = shallowMount(TrainView, {
+    global: {
+      plugins: [i18n],
+      stubs: {
+        AppButton: false,
+        StepActionBar: {
+          template: '<div><slot /><slot name="end" /><slot name="below" /></div>',
+        },
+        AppDialog: {
+          props: ['open', 'title', 'description'],
+          emits: ['close'],
+          template:
+            '<section v-if="open" role="dialog"><h2>{{ title }}</h2><p>{{ description }}</p><slot /><slot name="actions" /></section>',
+        },
+      },
+    },
+  })
+  mounted.push(wrapper)
+  return wrapper
+}
+
+function button(wrapper: VueWrapper, text: string) {
+  const found = wrapper.findAllComponents(AppButton).find((candidate) => candidate.text() === text)
+  expect(found, `Expected button: ${text}`).toBeDefined()
+  return found!
+}
+
+async function openConfirmation(wrapper: VueWrapper) {
+  await button(wrapper, '학습하기').trigger('click')
+  await flushPromises()
+  expect(wrapper.find('[role="dialog"]').exists()).toBe(true)
+  expect(training.run).not.toHaveBeenCalled()
+}
+
+beforeEach(async () => {
+  await setLocale('ko')
+  vi.clearAllMocks()
+  training.run.mockReset().mockResolvedValue(null)
+  training.running.value = false
+  training.progress.value = null
+  training.statuses.value = []
+  ojHostConfig.value = policyHost({
+    assignmentPolicy: {
+      version: 1,
+      allowedTaskTypes: ['classification'],
+      allowedAlgorithms: selectedAlgorithms.map(({ algorithm }) => algorithm),
+    },
+  })
+  store.file = numericProject()
+})
+
+afterEach(() => {
+  mounted.splice(0).forEach((wrapper) => wrapper.unmount())
+  ojHostConfig.value = null
+})
+
+describe('large-class training guidance and confirmation', () => {
+  it('explains 2,166 numeric classes before training and asks before starting any worker', async () => {
+    const wrapper = trainView()
+    const notice = wrapper.find('[role="status"]').text()
+    expect(notice).toContain('학습 전에 범주 수를 확인하세요')
+    expect(notice).toContain('2,166')
+    expect(notice).toContain('target')
+    expect(notice).toContain('회귀')
+    expect(notice).toContain('혼동 행렬')
+    expect(notice).toContain('정확도')
+    expect(notice).toContain('F1')
+    expect(wrapper.find('[role="dialog"]').exists()).toBe(false)
+    await openConfirmation(wrapper)
+    expect(wrapper.find('[role="dialog"]').text()).toContain('많은 범주로 분류 학습을 진행할까요?')
+    expect(wrapper.find('[role="dialog"]').text()).toContain('2,166')
+  })
+
+  it.each(['cancel-button', 'dialog-close'])(
+    '%s keeps the dataset and settings unchanged',
+    async (cancel) => {
+      const original = store.file!
+      const settings = JSON.stringify(original.document.settings)
+      const wrapper = trainView()
+      await openConfirmation(wrapper)
+      if (cancel === 'cancel-button') await button(wrapper, '취소').trigger('click')
+      else
+        wrapper
+          .findAllComponents(AppDialog)
+          .find((dialog) => dialog.props('open'))!
+          .vm.$emit('close')
+      await nextTick()
+      expect(wrapper.find('[role="dialog"]').exists()).toBe(false)
+      expect(training.run).not.toHaveBeenCalled()
+      expect(store.update).not.toHaveBeenCalled()
+      expect(store.file).toBe(original)
+      expect(store.file!.dataset).toBe(original.dataset)
+      expect(JSON.stringify(store.file!.document.settings)).toBe(settings)
+    },
+  )
+
+  it('only the explicit confirmation starts the original three-model request, once', async () => {
+    const original = store.file!
+    const settings = JSON.stringify(original.document.settings)
+    const wrapper = trainView()
+    await openConfirmation(wrapper)
+    await button(wrapper, '확인하고 학습').trigger('click')
+    await flushPromises()
+    expect(training.run).toHaveBeenCalledOnce()
+    const request = training.run.mock.calls[0]![0]
+    expect(request.input.dataset.rows).toHaveLength(8760)
+    expect(request.input.dataset.columns).toHaveLength(14)
+    expect(request.input.settings.selectedAlgorithms).toEqual(selectedAlgorithms)
+    expect(request.input.taskType).toBe('classification')
+    expect(JSON.stringify(store.file!.document.settings)).toBe(settings)
+    expect(store.file!.dataset).toBe(original.dataset)
+    expect(store.update).not.toHaveBeenCalled()
+    expect(wrapper.find('[role="dialog"]').exists()).toBe(false)
+  })
+
+  it('rejects repeated confirmation and start actions while the same training is pending', async () => {
+    let finish!: (value: null) => void
+    training.run.mockImplementationOnce(
+      () =>
+        new Promise((resolve) => {
+          finish = resolve
+        }),
+    )
+    const wrapper = trainView()
+    await openConfirmation(wrapper)
+    const confirm = button(wrapper, '확인하고 학습').props('action')!
+    const start = button(wrapper, '학습하기').props('action')!
+    const pending = confirm()
+    await confirm()
+    await start()
+    await flushPromises()
+    expect(training.run).toHaveBeenCalledOnce()
+    expect(button(wrapper, '학습하기').props('disabled')).toBe(true)
+    expect(wrapper.find('[role="dialog"]').exists()).toBe(false)
+    finish(null)
+    await pending
+    await nextTick()
+    expect(button(wrapper, '학습하기').props('disabled')).toBe(false)
+  })
+
+  it.each(['settings', 'dataset-hash'])(
+    'invalidates confirmation when %s changes',
+    async (changed) => {
+      const wrapper = trainView()
+      await openConfirmation(wrapper)
+      const staleConfirm = button(wrapper, '확인하고 학습').props('action')!
+      const original = store.file!
+      store.file =
+        changed === 'settings'
+          ? {
+              ...original,
+              document: {
+                ...original.document,
+                settings: {
+                  ...original.document.settings,
+                  split: { ...original.document.settings.split, randomState: 43 },
+                },
+              },
+            }
+          : { ...original, dataset: { ...original.dataset!, hash: 'changed-dataset-hash' } }
+      await nextTick()
+      expect(wrapper.find('[role="dialog"]').exists()).toBe(false)
+      await staleConfirm()
+      expect(training.run).not.toHaveBeenCalled()
+      await openConfirmation(wrapper)
+      await button(wrapper, '확인하고 학습').trigger('click')
+      await flushPromises()
+      expect(training.run).toHaveBeenCalledOnce()
+    },
+  )
+
+  it('checks the current assignment policy again when confirmation is accepted', async () => {
+    const wrapper = trainView()
+    await openConfirmation(wrapper)
+    ojHostConfig.value = policyHost({
+      assignmentPolicy: {
+        version: 1,
+        allowedTaskTypes: ['classification'],
+        allowedAlgorithms: ['naive_bayes'],
+      },
+    })
+    await nextTick()
+    await button(wrapper, '확인하고 학습').trigger('click')
+    await flushPromises()
+    expect(training.run).not.toHaveBeenCalled()
+    expect(store.update).not.toHaveBeenCalled()
+    expect(wrapper.find('[role="alert"]').text()).toContain('현재 선택에 허용되지 않은 모델')
+    expect(button(wrapper, '학습하기').props('disabled')).toBe(true)
+  })
+
+  it('leaves small-class training as a single click without a large-class warning', async () => {
+    store.file = numericProject(3)
+    const wrapper = trainView()
+    expect(wrapper.find('[role="status"]').exists()).toBe(false)
+    await button(wrapper, '학습하기').trigger('click')
+    await flushPromises()
+    expect(wrapper.find('[role="dialog"]').exists()).toBe(false)
+    expect(training.run).toHaveBeenCalledOnce()
+  })
+})

+    expect(store.dirty).toBe(false)
+    expect(store.savedAt).toBe(loadedAt)
+    expect(store.saving).toBe(false)
+  })
+
+  it('serializes a different project without letting the old completion mark it saved', async () => {
+    const store = useProjectStore()
+    const first = deferred()
+    const second = deferred()
+    vi.mocked(saveProject).mockReturnValueOnce(first.promise).mockReturnValueOnce(second.promise)
+    const savingFirst = store.save(snapshot('first', 'first-id'))
+    const next = snapshot('second', 'second-id')
+    const savingSecond = store.save(next)
+    expect(saveProject).toHaveBeenCalledOnce()
+    first.resolve()
+    await savingFirst
+    await vi.waitFor(() => expect(saveProject).toHaveBeenCalledTimes(2))
+    expect(store.file).toBe(next)
+    expect(store.dirty).toBe(true)
+    expect(store.savedAt).toBeNull()
+    expect(store.saving).toBe(true)
+    second.resolve()
+    await savingSecond
+    expect(store.dirty).toBe(false)
+    expect(store.saving).toBe(false)
+  })
+
+  it('does not make the next project inherit the previous project write failure', async () => {
+    const store = useProjectStore()
+    const pending = deferred()
+    vi.mocked(saveProject).mockReturnValueOnce(pending.promise)
+    const savingFirst = store.save(snapshot('first', 'first-id'))
+    const rejected = expect(savingFirst).rejects.toThrow('old failure')
+    const next = snapshot('second', 'second-id')
+    const savingSecond = store.save(next)
+    pending.reject(new Error('old failure'))
+    await rejected
+    await savingSecond
+    expect(vi.mocked(saveProject).mock.calls[1]?.[0]).toBe(next)
+    expect(store.dirty).toBe(false)
+  })
+
+  it('does not start queued writes after revocation', async () => {
+    const store = useProjectStore()
+    const pending = deferred()
+    vi.mocked(saveProject).mockReturnValueOnce(pending.promise)
+    const saving = store.save(snapshot('initial'))
+    store.update(snapshot('queued edit'))
+    const flushed = store.flush()
+    const rejected = Promise.all([
+      expect(saving).rejects.toMatchObject({ code: 'STORAGE_LOCKED' }),
+      expect(flushed).rejects.toMatchObject({ code: 'STORAGE_LOCKED' }),
+    ])
+    store.revoke()
+    pending.resolve()
+    await rejected
+    await vi.advanceTimersByTimeAsync(AUTOSAVE_DELAY_MS * 2)
+    expect(saveProject).toHaveBeenCalledOnce()
+    expect(store.file).toBeNull()
+    expect(store.dirty).toBe(false)
+    expect(store.savedAt).toBeNull()
+    expect(store.saving).toBe(false)
+    await expect(store.flush()).rejects.toMatchObject({ code: 'STORAGE_LOCKED' })
+  })
+
+  it('exports only after the shared save has persisted the latest snapshot', async () => {
+    const store = useProjectStore()
+    const first = deferred()
+    const last = deferred()
+    vi.mocked(saveProject).mockReturnValueOnce(first.promise).mockReturnValueOnce(last.promise)
+    const saving = store.save(snapshot('initial'))
+    const latest = snapshot('latest')
+    store.update(latest)
+    const deliver = vi.fn()
+    const exporting = store.exportFile('# report', deliver)
+    first.resolve()
+    await vi.waitFor(() => expect(saveProject).toHaveBeenCalledTimes(2))
+    expect(writeProject).not.toHaveBeenCalled()
+    expect(deliver).not.toHaveBeenCalled()
+    last.resolve()
+    await Promise.all([saving, exporting])
+    expect(writeProject).toHaveBeenCalledExactlyOnceWith(latest, '# report')
+    expect(deliver).toHaveBeenCalledOnce()
+    expect(markExported).toHaveBeenCalledOnce()
+    expect(store.dirty).toBe(false)
+  })
+})

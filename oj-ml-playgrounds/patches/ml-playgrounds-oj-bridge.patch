diff --git a/frontend/src/components/OjSubmitButton.vue b/frontend/src/components/OjSubmitButton.vue
new file mode 100644
index 0000000000000000000000000000000000000000..45410a74121c42327f03f719dce73208f224847f
--- /dev/null
+++ b/frontend/src/components/OjSubmitButton.vue
@@ -0,0 +1,129 @@
+<script setup lang="ts">
+import { computed, ref, useId, watch } from 'vue'
+import { useI18n } from 'vue-i18n'
+
+import AppButton from '@/components/AppButton.vue'
+import AppDialog from '@/components/AppDialog.vue'
+import { ACTION_ICONS } from '@/icons'
+import { ojHostConfig, submitProjectToOjHost } from '@/oj-host-v2'
+import { ojSubmissionPolicyIssue } from '@/oj-assignment-policy'
+import { exportIdentifiedProject } from '@/project/identified-export'
+import { identityOf } from '@/project/identity'
+import { useProjectStore } from '@/stores/project'
+import { useToastStore } from '@/stores/toasts'
+
+const { t, locale } = useI18n()
+const project = useProjectStore()
+const toasts = useToastStore()
+
+const submitted = ref(false)
+const submissionError = ref<string | null>(null)
+const policyIssue = computed(() =>
+  project.file === null ? null : ojSubmissionPolicyIssue(ojHostConfig.value, project.file.document),
+)
+const canSubmitToOj = computed(
+  () => ojHostConfig.value?.attemptId !== undefined && project.file !== null,
+)
+const submitBlocked = computed(() => submitted.value || policyIssue.value !== null)
+const submissionIssue = computed(() => policyIssue.value ?? submissionError.value)
+const issueOpen = ref(false)
+const issueId = useId()
+
+function closeIssue(): void {
+  issueOpen.value = false
+}
+
+watch(submissionIssue, (issue) => {
+  if (issue === null) closeIssue()
+})
+watch(() => project.file?.document.manifest.projectId, closeIssue)
+
+async function submit(): Promise<void> {
+  const file = project.file
+  if (file === null) return
+  submissionError.value = null
+  // Check the current in-memory snapshot before identity changes, serialization or upload.
+  if (ojSubmissionPolicyIssue(ojHostConfig.value, file.document) !== null) return
+
+  try {
+    const dropped = await exportIdentifiedProject(
+      project,
+      identityOf(file.document.manifest),
+      (key) => t(key),
+      locale.value,
+      submitProjectToOjHost,
+    )
+    toasts.push('success', 'project.submitOjDone')
+    if (dropped.length > 0) {
+      toasts.push('caution', 'project.exportDropped', { count: dropped.length })
+    }
+    submitted.value = true
+  } catch (error) {
+    if (error instanceof Error && error.message === 'PROJECT_CHANGED_DURING_EXPORT') {
+      submissionError.value = t('project.submitOjChanged')
+    }
+    toasts.push('danger', 'project.submitOjFailed')
+  }
+}
+</script>
+
+<template>
+  <div v-if="canSubmitToOj" class="flex min-w-0 shrink-0 items-center gap-1">
+    <AppButton
+      :action="submit"
+      :disabled="submitBlocked"
+      :label="t(submitted ? 'project.submitOjComplete' : 'project.submitOj')"
+    >
+      <template #pending>
+        <component :is="ACTION_ICONS.exportFile" :size="18" aria-hidden="true" />
+        <span class="max-md:hidden">{{ t('project.submitOjPending') }}</span>
+      </template>
+      <component :is="ACTION_ICONS.exportFile" :size="18" aria-hidden="true" />
+      <span class="max-md:hidden">
+        {{ t(submitted ? 'project.submitOjComplete' : 'project.submitOj') }}
+      </span>
+    </AppButton>
+    <!-- A fixed-height toolbar holds controls only, never the expanded error text. -->
+    <AppButton
+      v-if="submissionIssue"
+      variant="secondary"
+      :label="t('project.submitOjPreflight')"
+      :title="t('project.submitOjPreflight')"
+      aria-haspopup="dialog"
+      :aria-expanded="issueOpen"
+      :aria-controls="issueId"
+      @click="issueOpen = true"
+    >
+      <component
+        :is="ACTION_ICONS.submissionIssue"
+        :size="18"
+        class="text-danger"
+        aria-hidden="true"
+      />
+      <span class="max-md:hidden">{{ t('project.submitOjReason') }}</span>
+    </AppButton>
+    <AppDialog
+      :id="issueId"
+      class="oj-submission-dialog"
+      :open="issueOpen"
+      :title="t('project.submitOjIssueTitle')"
+      :aria-label="t('project.submitOjIssueTitle')"
+      :aria-describedby="`${issueId}-reason`"
+      @close="closeIssue"
+    >
+      <p
+        v-if="issueOpen"
+        :id="`${issueId}-reason`"
+        class="whitespace-pre-wrap wrap-anywhere leading-relaxed"
+        tabindex="-1"
+        autofocus
+        role="alert"
+      >
+        {{ submissionIssue }}
+      </p>
+      <template #actions>
+        <AppButton variant="secondary" @click="closeIssue">{{ t('common.dismiss') }}</AppButton>
+      </template>
+    </AppDialog>
+  </div>
+</template>

+// @vitest-environment jsdom
+
+import { shallowReactive } from 'vue'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import {
+  createOjPortfolioAdapter,
+  parseOjPortfolioTemplate,
+  type OjPortfolioProject,
+  type OjPortfolioRequest,
+} from '../src/oj-portfolio-template'
+import {
+  MAX_PORTFOLIO_BYTES,
+  OJ_PORTFOLIO_MAX_SECTIONS,
+  OJ_PORTFOLIO_MAX_TEMPLATE_BYTES,
+} from '../src/limits'
+import { emptyProjectFile } from './fixtures/project'
+
+const disposers: Array<() => void> = []
+const template = {
+  sections: [{ id: 'question-1', title: '문제 정의', description: '해결할 문제를 설명하세요.' }],
+  locale: 'ko',
+}
+
+function adapterFixture() {
+  const project = shallowReactive<OjPortfolioProject>({
+    file: emptyProjectFile(),
+    opening: false,
+    update(file) {
+      this.file = file
+    },
+    flush: vi.fn(async () => undefined),
+  })
+  const publish = vi.fn()
+  const navigate = vi.fn()
+  const adapter = createOjPortfolioAdapter(project, publish, navigate)
+  disposers.push(adapter.dispose)
+  const request = (extra = {}): OjPortfolioRequest => ({
+    requestId: 'request_1234567890',
+    projectId: adapter.current().projectId!,
+    projectToken: adapter.current().projectToken!,
+    template,
+    ...extra,
+  })
+  return { project, publish, navigate, adapter, request }
+}
+
+afterEach(() => {
+  disposers.splice(0).forEach((dispose) => dispose())
+  vi.restoreAllMocks()
+})
+
+describe('bound portfolio adapter', () => {
+  it('appends questions, preserves answers/attachments and saves before acknowledgement', async () => {
+    const { project, adapter, request, navigate } = adapterFixture()
+    const original = project.file!
+    original.document.portfolio = {
+      answerFormat: 'plain-v1',
+      template: { sections: [{ id: 'existing', title: '원래 문항' }] },
+      answers: { existing: '학생이 이미 쓴 답', orphan: '이전 답' },
+      attachments: { existing: ['portfolio/attachments/1.png'] },
+    }
+    const answers = original.document.portfolio.answers
+    const attachments = original.document.portfolio.attachments
+    let finish!: () => void
+    project.flush = vi.fn(
+      () =>
+        new Promise<void>((resolve) => {
+          finish = resolve
+        }),
+    )
+    const result = adapter.apply(request())
+    expect(navigate).not.toHaveBeenCalled()
+    expect(project.file!.document.portfolio.answers).toBe(answers)
+    expect(project.file!.document.portfolio.attachments).toBe(attachments)
+    expect(project.file!.document.portfolio.template.sections).toHaveLength(2)
+    finish()
+    await expect(result).resolves.toEqual({ state: 'applied', added: 1 })
+    expect(navigate).toHaveBeenCalledWith(request().projectId)
+  })
+
+  it('does not duplicate questions or change answers on another explicit application', async () => {
+    const { project, adapter, request } = adapterFixture()
+    await adapter.apply(request())
+    project.file!.document.portfolio.answers['question-1'] = '유지해야 하는 답'
+    await expect(adapter.apply(request())).resolves.toEqual({ state: 'unchanged', added: 0 })
+    expect(project.file!.document.portfolio.answers['question-1']).toBe('유지해야 하는 답')
+    expect(project.file!.document.portfolio.template.sections).toHaveLength(1)
+  })
+
+  it('rejects conflicting question text with the same ID without mutations', async () => {
+    const { project, adapter, request } = adapterFixture()
+    await adapter.apply(request())
+    const before = project.file
+    await expect(
+      adapter.apply(
+        request({ template: { sections: [{ id: 'question-1', title: '다른 문제' }] } }),
+      ),
+    ).resolves.toMatchObject({ state: 'error', code: 'OJ_PORTFOLIO_TEMPLATE_CONFLICT' })
+    expect(project.file).toBe(before)
+  })
+
+  it('requires an active project and invalidates a token when opening or reopening it', async () => {
+    const { project, adapter, request, navigate } = adapterFixture()
+    const stale = request()
+    project.opening = true
+    expect(adapter.current().projectToken).toBeNull()
+    await expect(adapter.apply(stale)).resolves.toMatchObject({ code: 'OJ_PORTFOLIO_NO_PROJECT' })
+    project.opening = false
+    expect(adapter.current().projectToken).not.toBe(stale.projectToken)
+    await expect(adapter.apply(stale)).resolves.toMatchObject({
+      code: 'OJ_PORTFOLIO_PROJECT_CHANGED',
+    })
+    project.file = null
+    await expect(adapter.apply(stale)).resolves.toMatchObject({ code: 'OJ_PORTFOLIO_NO_PROJECT' })
+    expect(navigate).not.toHaveBeenCalled()
+  })
+
+  it('ignores stale completion after project change and never navigates back', async () => {
+    const { project, adapter, request, navigate } = adapterFixture()
+    let finish!: () => void
+    project.flush = () =>
+      new Promise<void>((resolve) => {
+        finish = resolve
+      })
+    const pending = adapter.apply(request())
+    project.file = null
+    const next = emptyProjectFile()
+    next.document.manifest.projectId = 'different-project'
+    project.file = next
+    finish()
+    await expect(pending).resolves.toMatchObject({ code: 'OJ_PORTFOLIO_PROJECT_CHANGED' })
+    expect(next.document.portfolio.template.sections).toHaveLength(0)
+    expect(navigate).not.toHaveBeenCalled()
+  })
+
+  it('storage failure retains in-memory work but never claims success', async () => {
+    const { project, adapter, request, navigate } = adapterFixture()
+    project.flush = vi.fn(async () => {
+      throw new Error('quota')
+    })
+    await expect(adapter.apply(request())).resolves.toMatchObject({
+      code: 'OJ_PORTFOLIO_SAVE_FAILED',
+    })
+    expect(project.file!.document.portfolio.template.sections).toHaveLength(1)
+    expect(navigate).not.toHaveBeenCalled()
+    project.flush = vi.fn(async () => undefined)
+    await expect(adapter.apply(request())).resolves.toEqual({ state: 'unchanged', added: 0 })
+  })
+
+  it('revocation during persistence invalidates completion and future calls', async () => {
+    const { project, adapter, request, navigate } = adapterFixture()
+    const original = request()
+    let finish!: () => void
+    project.flush = () =>
+      new Promise<void>((resolve) => {
+        finish = resolve
+      })
+    const pending = adapter.apply(original)
+    adapter.dispose()
+    finish()
+    await expect(pending).resolves.toMatchObject({ code: 'OJ_PORTFOLIO_PROJECT_CHANGED' })
+    await expect(adapter.apply(original)).resolves.toMatchObject({
+      code: 'OJ_PORTFOLIO_NO_PROJECT',
+    })
+    expect(navigate).not.toHaveBeenCalled()
+  })
+
+  it('checks the existing answers and attachment-inclusive portfolio limit before mutation', async () => {
+    const { project, adapter, request } = adapterFixture()
+    const original = project.file!
+    original.document.portfolio.answers['old'] = 'a'.repeat(MAX_PORTFOLIO_BYTES)
+    await expect(adapter.apply(request())).resolves.toMatchObject({
+      code: 'OJ_PORTFOLIO_TOO_LARGE',
+    })
+    expect(project.file).toBe(original)
+  })
+
+  it('title edits keep the project token stable but publish the updated project name', () => {
+    const { project, adapter, publish } = adapterFixture()
+    const token = adapter.current().projectToken
+    const original = project.file!
+    project.file = {
+      ...original,
+      document: {
+        ...original.document,
+        manifest: { ...original.document.manifest, name: '새 이름' },
+      },
+    }
+    expect(adapter.current().projectToken).toBe(token)
+    expect(publish).toHaveBeenLastCalledWith(
+      expect.objectContaining({ projectName: '새 이름', projectToken: token }),
+    )
+  })
+})
+
+describe('portfolio request parser', () => {
+  it('accepts stable Unicode question IDs and strips no answers because answers are forbidden', () => {
+    expect(
+      parseOjPortfolioTemplate({ sections: [{ id: '문제-정의', title: '문제 정의' }] }),
+    ).not.toBeNull()
+    expect(parseOjPortfolioTemplate({ ...template, answers: { a: 'not accepted' } })).toBeNull()
+  })
+  it.each([
+    null,
+    { sections: [] },
+    { sections: [{ id: '__proto__', title: 'bad' }] },
+    {
+      sections: [
+        { id: 'x', title: 'x' },
+        { id: 'x', title: 'again' },
+      ],
+    },
+    { sections: [{ id: 'x', title: 'x', required: true }] },

+import { isClientError } from '../errors'
+import { MAX_DENSE_CLASSIFICATION_LABELS } from '../limits'
+import type { ProjectFile } from '../project/format'
+import { dataSettings, type Settings, type TaskType } from '../project/schema'
+import { detectKind, targetValues, usableRows, type Dataset } from './preprocess'
+import { sampleRows } from './sample'
+
+export interface ClassificationMemoryNotice {
+  readonly target: string
+  readonly classes: number
+  readonly numeric: boolean
+}
+
+/**
+ * 학습과 같은 결측 제거·표본 추출·라벨 공백 정규화를 쓴다. 분할 전 입력의 범주를
+ * 세므로 테스트에만 남은 범주도 포함한다. 별도 테스트 파일도 같은 규칙으로 센다.
+ * 안내일 뿐 학습을 거부하거나 설정/데이터를 변경하지 않는다.
+ */
+export function classificationMemoryNotice(input: {
+  dataset: Dataset | null
+  testDataset?: Dataset | null
+  settings: Settings
+  taskType: TaskType | undefined
+}): ClassificationMemoryNotice | null {
+  if (input.taskType !== 'classification' || input.dataset === null) return null
+  const { dataset, settings } = input
+  const data = dataSettings('tabular', settings)
+  const { target, features, preprocessing } = data
+  if (!target || !dataset.columns.includes(target)) return null
+
+  const usable = usableRows(dataset, features, target, preprocessing.missing)
+  const usableLabels = targetValues(dataset, usable, target)
+  let sampled: number[]
+  try {
+    sampled = sampleRows({ rows: usable, labels: usableLabels }, settings.split, settings.nSamples)
+  } catch (error) {
+    // 성립하지 않는 표본 설정은 기존 학습 계획이 사유를 설명한다.
+    if (isClientError(error)) return null
+    throw error
+  }
+  const labels = new Set(targetValues(dataset, sampled, target))
+  const testDataset = input.testDataset
+  if (settings.split.method === 'provided' && testDataset?.columns.includes(target)) {
+    const testRows = usableRows(testDataset, features, target, preprocessing.missing)
+    for (const label of targetValues(testDataset, testRows, target)) labels.add(label)
+  }
+  if (labels.size <= MAX_DENSE_CLASSIFICATION_LABELS) return null
+  return { target, classes: labels.size, numeric: detectKind([...labels]) === 'numeric' }
+}
+
+/** 확인 후 데이터·타깃·학습 설정이 바뀌면 예전 확인으로 학습하지 않는다. */
+export function classificationConfirmationKey(file: ProjectFile | null): string {
+  if (!file) return ''
+  return JSON.stringify({
+    projectId: file.document.manifest.projectId,
+    taskType: file.document.manifest.taskType,
+    dataset: file.dataset?.hash,
+    testDataset: file.testDataset?.hash,
+    settings: file.document.settings,
+  })
+}

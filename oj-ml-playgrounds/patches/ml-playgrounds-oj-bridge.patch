--- /dev/null
+++ b/frontend/src/ml/result-window.ts
@@ -0,0 +1,32 @@
+import { RESULTS_TABLE_PAGE_SIZE } from '@/limits'
+
+export interface ResultWindow {
+  readonly total: number
+  readonly page: number
+  readonly pages: number
+  readonly start: number
+  readonly end: number
+  readonly hasPrevious: boolean
+  readonly hasNext: boolean
+}
+
+/** Bounded display windows never truncate or mutate the saved result. */
+export function resultWindow(total: number, page: number): ResultWindow {
+  const pages = Math.max(1, Math.ceil(total / RESULTS_TABLE_PAGE_SIZE))
+  const bounded = Math.min(Math.max(0, Math.trunc(page)), pages - 1)
+  const start = bounded * RESULTS_TABLE_PAGE_SIZE
+  return {
+    total,
+    page: bounded,
+    pages,
+    start,
+    end: Math.min(total, start + RESULTS_TABLE_PAGE_SIZE),
+    hasPrevious: bounded > 0,
+    hasNext: bounded < pages - 1,
+  }
+}
+
+/** Allocate only the visible indices, including for a legacy dense matrix. */
+export function resultIndices(window: ResultWindow): number[] {
+  return Array.from({ length: window.end - window.start }, (_, offset) => window.start + offset)
+}
diff --git a/frontend/src/oj-assignment-policy.ts b/frontend/src/oj-assignment-policy.ts
new file mode 100644
index 0000000000000000000000000000000000000000..94701a2cf6f297b11d0a7a65fdfa1587c21d910f
--- /dev/null
+++ b/frontend/src/oj-assignment-policy.ts
@@ -0,0 +1,162 @@
+/** OJ assignment constraints. Pure checks never rewrite a student's project or history. */
+import type { ProjectDocument, TaskType } from './project/schema'
+import { OJ_ASSIGNMENT_MAX_ALGORITHMS, OJ_ASSIGNMENT_MAX_SHOWN_CONFLICTS } from './limits'
+
+export interface OjAssignmentPolicy {
+  readonly version: 1
+  readonly allowedTaskTypes: readonly TaskType[]
+  /** An empty list explicitly permits all algorithms. Missing is not unrestricted. */
+  readonly allowedAlgorithms: readonly string[]
+}
+
+interface PolicyHost {
+  readonly assignmentPolicy?: OjAssignmentPolicy | null
+}
+
+const TASK_LABELS: Readonly<Record<TaskType, string>> = {
+  classification: '분류',
+  regression: '회귀',
+  clustering: '군집',
+}
+const ALGORITHM_LABELS: Readonly<Record<string, string>> = {
+  decision_tree: '결정 트리',
+  knn: 'K-최근접 이웃',
+  logistic_regression: '로지스틱 회귀',
+  random_forest: '랜덤 포레스트',
+  naive_bayes: '나이브 베이즈',
+  svm: '서포트 벡터 머신',
+  linear_regression: '선형 회귀',
+  k_means: 'K-평균',
+}
+const INVALID_POLICY =
+  '과제의 허용 유형·모델 설정을 확인할 수 없습니다. 과제 화면에서 실습을 다시 열어 주세요. 계속되면 선생님에게 알려 주세요.'
+
+export function parseOjAssignmentPolicy(value: unknown): OjAssignmentPolicy | null {
+  if (typeof value !== 'object' || value === null || Array.isArray(value)) return null
+  const policy = value as Record<string, unknown>
+  if (
+    policy.version !== 1 ||
+    !Array.isArray(policy.allowedTaskTypes) ||
+    !Array.isArray(policy.allowedAlgorithms)
+  )
+    return null
+  const tasks = policy.allowedTaskTypes
+  const algorithms = policy.allowedAlgorithms
+  if (
+    tasks.length === 0 ||
+    tasks.length > Object.keys(TASK_LABELS).length ||
+    tasks.some((task) => typeof task !== 'string' || !Object.hasOwn(TASK_LABELS, task))
+  )
+    return null
+  if (
+    algorithms.length > OJ_ASSIGNMENT_MAX_ALGORITHMS ||
+    algorithms.some((id) => typeof id !== 'string' || !/^[a-z][a-z0-9_]{0,63}$/.test(id))
+  )
+    return null
+  if (new Set(tasks).size !== tasks.length || new Set(algorithms).size !== algorithms.length)
+    return null
+  return Object.freeze({
+    version: 1,
+    allowedTaskTypes: Object.freeze([...tasks]) as readonly TaskType[],
+    allowedAlgorithms: Object.freeze([...algorithms]) as readonly string[],
+  })
+}
+
+function policyOf(host: PolicyHost): OjAssignmentPolicy | null {
+  return parseOjAssignmentPolicy(host.assignmentPolicy)
+}
+
+function algorithmLabel(id: string): string {
+  if (id === '') return '(빈 모델 ID)'
+  return Object.hasOwn(ALGORITHM_LABELS, id) ? `${ALGORITHM_LABELS[id]} (${id})` : id
+}
+
+function allowedSummary(policy: OjAssignmentPolicy): string {
+  return `허용 유형: ${policy.allowedTaskTypes.map((task) => TASK_LABELS[task]).join(', ')}. 허용 모델: ${policy.allowedAlgorithms.length === 0 ? '제한 없음' : policy.allowedAlgorithms.map(algorithmLabel).join(', ')}.`
+}
+
+export function ojTaskTypePolicyIssue(
+  host: PolicyHost | null,
+  taskType: TaskType | undefined,
+): string | null {
+  if (host === null) return null
+  const policy = policyOf(host)
+  if (policy === null) return INVALID_POLICY
+  if (taskType === undefined) return `학습 유형을 먼저 선택해 주세요. ${allowedSummary(policy)}`
+  return policy.allowedTaskTypes.includes(taskType)
+    ? null
+    : `이 과제에서 ${TASK_LABELS[taskType]} 유형을 사용할 수 없습니다. ${allowedSummary(policy)}`
+}
+
+export function ojAlgorithmPolicyIssue(
+  host: PolicyHost | null,
+  algorithm: string,
+  taskType?: TaskType,
+): string | null {
+  if (host === null) return null
+  const issue = ojTaskTypePolicyIssue(host, taskType)
+  if (issue !== null) return issue
+  const policy = policyOf(host)!
+  return policy.allowedAlgorithms.length === 0 || policy.allowedAlgorithms.includes(algorithm)
+    ? null
+    : `이 과제에서 ${algorithmLabel(algorithm)} 모델을 사용할 수 없습니다. ${allowedSummary(policy)}`
+}
+
+export function ojSelectionPolicyIssue(
+  host: PolicyHost | null,
+  taskType: TaskType | undefined,
+  selected: readonly { algorithm: string }[],
+): string | null {
+  if (host === null) return null
+  const taskIssue = ojTaskTypePolicyIssue(host, taskType)
+  if (taskIssue !== null) return taskIssue
+  const policy = policyOf(host)!
+  const conflicts = [
+    ...new Set(
+      selected
+        .map((row) => row.algorithm)
+        .filter(
+          (id) =>
+            id === '' ||
+            (policy.allowedAlgorithms.length > 0 && !policy.allowedAlgorithms.includes(id)),
+        ),
+    ),
+  ]
+  return conflicts.length === 0
+    ? null
+    : `현재 선택에 허용되지 않은 모델이 있습니다: ${conflicts.map(algorithmLabel).join(', ')}. 선택 목록에서 직접 빼거나 허용 모델로 바꿔 주세요. ${allowedSummary(policy)}`
+}
+
+export function ojSubmissionPolicyIssue(
+  host: PolicyHost | null,
+  document: ProjectDocument,
+): string | null {
+  if (host === null) return null
+  const selectionIssue = ojSelectionPolicyIssue(
+    host,
+    document.manifest.taskType,
+    document.settings.selectedAlgorithms,
+  )
+  const policy = policyOf(host)
+  if (policy === null) return INVALID_POLICY
+  const conflicts = document.runs.experiments.flatMap((experiment) =>
+    experiment.runs
+      .filter(
+        (run) =>
+          run.algorithm !== '' &&
+          policy.allowedAlgorithms.length > 0 &&
+          !policy.allowedAlgorithms.includes(run.algorithm),
+      )
+      .map((run) => `실험 ${experiment.id} / 기록 ${run.id}: ${algorithmLabel(run.algorithm)}`),
+  )
+  const shown = conflicts.slice(0, OJ_ASSIGNMENT_MAX_SHOWN_CONFLICTS).join('; ')
+  const remaining =
+    conflicts.length > OJ_ASSIGNMENT_MAX_SHOWN_CONFLICTS
+      ? ` 외 ${conflicts.length - OJ_ASSIGNMENT_MAX_SHOWN_CONFLICTS}건`
+      : ''
+  const historyIssue =
+    conflicts.length === 0
+      ? null
+      : `과거 학습 기록에 허용되지 않은 모델이 있습니다(총 ${conflicts.length}건): ${shown}${remaining}. 기존 기록은 보존됩니다. 프로젝트 목록에서 이 과제용 새 프로젝트를 만들어 허용 모델로 실습해 제출해 주세요. ${allowedSummary(policy)}`
+  return [selectionIssue, historyIssue].filter(Boolean).join(' ') || null
+}
diff --git a/frontend/src/oj-host-v2.ts b/frontend/src/oj-host-v2.ts
new file mode 100644
index 0000000000000000000000000000000000000000..719abd476da65e739eddb5babe6cc31feb71c0d3
--- /dev/null
+++ b/frontend/src/oj-host-v2.ts
@@ -0,0 +1,387 @@
+/**
+ * WordPress OJ host bridge for shared-computer storage isolation.
+ *
+ * When embedded by OJ, the app does not mount until an authenticated storage
+ * context has arrived. This prevents a previous user's IndexedDB from being
+ * rendered before the current user scope is known.
+ */
+
+import { shallowRef } from 'vue'
+import { parseOjAssignmentPolicy, type OjAssignmentPolicy } from './oj-assignment-policy'
+import {
+  OJ_PORTFOLIO_REQUEST_CACHE_SIZE,
+  OJ_PORTFOLIO_MAX_PROJECT_ID_LENGTH,
+  OJ_PORTFOLIO_MAX_TOKEN_LENGTH,
+} from './limits'
+import {
+  parseOjPortfolioTemplate,
+  type OjPortfolioRequest,
+  type OjPortfolioResult,
+  type OjPortfolioTarget,
+} from './oj-portfolio-template'
+
+const PROTOCOL_VERSION = 2 as const
+const CONFIG_TIMEOUT_MS = 30_000
+const SCOPE_PATTERN = /^[A-Za-z0-9_-]{20,64}$/
+const STORAGE_KEY_PATTERN = /^[A-Za-z0-9_-]{43}$/
+const FRAME_NONCE_PATTERN = /^[a-f0-9]{32}$/
+
+export interface OjHostConfig {
+  assignmentPolicy?: OjAssignmentPolicy | null
+  assignmentId: string
+  attemptId?: string
+  restRoot: string
+  nonce: string
+  privacyUrl: string
+  maxBytes?: number
+  storageScope: string
+  storageSession: string
+  storageKey: string
+  storageDatabase: string
+  storageKeyVersion: 1
+  deviceMode: 'shared'
+}
+
+interface ConfigureMessage extends OjHostConfig {
+  type: 'oj-ml:configure'
+  version: typeof PROTOCOL_VERSION
+  frameNonce: string
+}
+
+interface SubmissionResponse {
+  data?: { receipt?: unknown; attempt?: unknown }
+}
+
+type WipeHandler = () => Promise<void>
+
+export const ojHostConfig = shallowRef<OjHostConfig | null>(null)
+
+let frameNonce = ''
+let wipeHandler: WipeHandler | null = null
+type PortfolioHandler = (request: OjPortfolioRequest) => Promise<OjPortfolioResult>
+let portfolioHandler: PortfolioHandler | null = null
+let portfolioPending: string | null = null
+const portfolioReplies = new Map<
+  string,
+  {
+    fingerprint: string
+    response: Promise<OjPortfolioResult>
+  }
+>()
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null
+}
+
+function asOptionalString(value: unknown): string | undefined {
+  return typeof value === 'string' && value.length > 0 ? value : undefined
+}
+
+function httpUrl(value: unknown): string | null {
+  if (typeof value !== 'string' || value.length === 0) return null
+  try {
+    const url = new URL(value, window.location.href)
+    return url.protocol === 'http:' || url.protocol === 'https:' ? url.href : null
+  } catch {
+    return null
+  }
+}
+
+function parseConfigure(value: unknown): ConfigureMessage | null {
+  if (!isRecord(value)) return null
+  if (value.type !== 'oj-ml:configure' || value.version !== PROTOCOL_VERSION) return null
+  if (value.frameNonce !== frameNonce) return null
+
+  const assignmentId = asOptionalString(value.assignmentId)
+  const restRoot = asOptionalString(value.restRoot)
+  const nonce = asOptionalString(value.nonce)
+  const privacyUrl = httpUrl(value.privacyUrl)
+  const storageScope = asOptionalString(value.storageScope)
+  const storageSession = asOptionalString(value.storageSession)
+  const storageKey = asOptionalString(value.storageKey)
+  const storageDatabase = asOptionalString(value.storageDatabase)
+  if (
+    assignmentId === undefined ||
+    restRoot === undefined ||
+    nonce === undefined ||
+    privacyUrl === null ||
+    storageScope === undefined ||
+    storageSession === undefined ||
+    storageKey === undefined ||
+    storageDatabase === undefined ||
+    value.storageKeyVersion !== 1 ||
+    value.deviceMode !== 'shared' ||
+    !SCOPE_PATTERN.test(storageScope) ||
+    !SCOPE_PATTERN.test(storageSession) ||
+    !STORAGE_KEY_PATTERN.test(storageKey) ||
+    storageDatabase !== `ml-playgrounds-oj-v1-${storageScope}`
+  ) {
+    return null
+  }
+
+  const attemptId = asOptionalString(value.attemptId)
+  const maxBytes =
+    typeof value.maxBytes === 'number' && Number.isSafeInteger(value.maxBytes) && value.maxBytes > 0
+      ? value.maxBytes
+      : undefined
+  const configured: ConfigureMessage = {
+    assignmentPolicy: parseOjAssignmentPolicy(value.assignmentPolicy),
+    type: 'oj-ml:configure',
+    version: PROTOCOL_VERSION,
+    frameNonce,
+    assignmentId,
+    restRoot,
+    nonce,
+    privacyUrl,
+    storageScope,
+    storageSession,
+    storageKey,
+    storageDatabase,
+    storageKeyVersion: 1,
+    deviceMode: 'shared',
+  }
+  if (attemptId !== undefined) configured.attemptId = attemptId
+  if (maxBytes !== undefined) configured.maxBytes = maxBytes
+  return configured
+}
+
+function sameOriginRestRoot(value: string): string | null {
+  const url = new URL(value, window.location.href)
+  if (url.origin !== window.location.origin) return null
+  return url.href.replace(/\/+$/, '')
+}
+
+function randomFrameNonce(): string {
+  const bytes = window.crypto.getRandomValues(new Uint8Array(16))
+  return Array.from(bytes, (byte) => byte.toString(16).padStart(2, '0')).join('')
+}
+
+function postToHostWithNonce(message: Record<string, unknown>, replyFrameNonce: string): void {
+  if (window.parent === window || !FRAME_NONCE_PATTERN.test(replyFrameNonce)) return
+  window.parent.postMessage(
+    { version: PROTOCOL_VERSION, frameNonce: replyFrameNonce, ...message },
+    window.location.origin,
+  )
+}
+
+function postToHost(message: Record<string, unknown>): void {
+  postToHostWithNonce(message, frameNonce)
+}
+
+function notifyHost(
+  state: 'submitting' | 'submitted' | 'error',
+  details: Record<string, unknown> = {},
+): void {
+  postToHost({
+    type: 'oj-ml:submission-status',
+    state,
+    assignmentId: ojHostConfig.value?.assignmentId,
+    attemptId: ojHostConfig.value?.attemptId,
+    ...details,
+  })
+}
+
+export function registerOjStorageWipeHandler(handler: WipeHandler): void {
+  wipeHandler = handler
+}
+
+export function registerOjPortfolioHandler(handler: PortfolioHandler): void {
+  portfolioHandler = handler
+}
+
+export function notifyOjPortfolioProject(target: OjPortfolioTarget): void {
+  const config = ojHostConfig.value
+  if (config === null) return
+  postToHost({
+    type: 'oj-ml:portfolio-project',
+    assignmentId: config.assignmentId,
+    storageSession: config.storageSession,
+    ...target,
+  })
+}
+
+function handlePortfolioRequest(data: Record<string, unknown>): void {
+  const config = ojHostConfig.value
+  if (
+    config === null ||
+    data.assignmentId !== config.assignmentId ||
+    data.storageSession !== config.storageSession
+  )
+    return
+  if (typeof data.requestId !== 'string' || !/^[A-Za-z0-9_-]{16,80}$/.test(data.requestId)) return
+  if (
+    typeof data.projectId !== 'string' ||
+    data.projectId.length > OJ_PORTFOLIO_MAX_PROJECT_ID_LENGTH ||
+    typeof data.projectToken !== 'string' ||
+    data.projectToken.length > OJ_PORTFOLIO_MAX_TOKEN_LENGTH
+  )
+    return
+  const requestId = data.requestId
+  const replyNonce = frameNonce
+  const reply = (result: OjPortfolioResult) => {
+    // A promise that outlives revoke must not republish a previous user's result.
+    if (ojHostConfig.value !== config || frameNonce !== replyNonce) return
+    postToHost({
+      type: 'oj-ml:portfolio-template-result',
+      assignmentId: config.assignmentId,
+      storageSession: config.storageSession,
+      requestId,
+      projectId: data.projectId,
+      projectToken: data.projectToken,
+      ...result,
+    })
+  }
+  const error = (code: string): OjPortfolioResult => ({ state: 'error', added: 0, code })
+  const template = parseOjPortfolioTemplate(data.template)
+  if (template === null) return reply(error('OJ_PORTFOLIO_TEMPLATE_INVALID'))
+  const request: OjPortfolioRequest = {
+    requestId,
+    projectId: data.projectId,
+    projectToken: data.projectToken,
+    template,
+  }
+  const fingerprint = JSON.stringify(request)
+  const previous = portfolioReplies.get(requestId)
+  if (previous !== undefined) {
+    if (previous.fingerprint !== fingerprint) return reply(error('OJ_PORTFOLIO_REQUEST_CONFLICT'))
+    void previous.response.then(reply)
+    return
+  }
+  if (portfolioPending !== null) return reply(error('OJ_PORTFOLIO_BUSY'))
+  const handler = portfolioHandler
+  if (handler === null) return reply(error('OJ_PORTFOLIO_NOT_READY'))
+  portfolioPending = requestId
+  const response = Promise.resolve()
+    .then(() => {
+      if (ojHostConfig.value !== config || frameNonce !== replyNonce) {
+        return error('OJ_PORTFOLIO_PROJECT_CHANGED')
+      }
+      return handler(request)
+    })
+    .catch(() => error('OJ_PORTFOLIO_SAVE_FAILED'))
+    .finally(() => {
+      if (portfolioPending === requestId) portfolioPending = null
+    })
+  if (portfolioReplies.size >= OJ_PORTFOLIO_REQUEST_CACHE_SIZE) {
+    const oldest = portfolioReplies.keys().next().value
+    if (oldest !== undefined) portfolioReplies.delete(oldest)
+  }
+  portfolioReplies.set(requestId, { fingerprint, response })
+  void response.then(reply)
+}
+
+export function revokeOjHostBridge(notifyParent = false): void {
+  const replyFrameNonce = frameNonce
+  ojHostConfig.value = null
+  wipeHandler = null
+  portfolioHandler = null
+  portfolioPending = null
+  portfolioReplies.clear()
+  frameNonce = ''
+  if (notifyParent) {
+    postToHostWithNonce({ type: 'oj-ml:storage-revoked' }, replyFrameNonce)
+  }
+}
+
+export function initOjHostBridge(): Promise<OjHostConfig | null> {
+  if (window.parent === window) {
+    return Promise.reject(new Error('OJ_HOST_REQUIRED'))
+  }
+
+  frameNonce = randomFrameNonce()
+  return new Promise<OjHostConfig>((resolve, reject) => {
+    let settled = false
+    const timeout = window.setTimeout(() => {
+      if (settled) return
+      settled = true
+      reject(new Error('OJ_HOST_CONFIG_TIMEOUT'))
+    }, CONFIG_TIMEOUT_MS)
+
+    window.addEventListener('message', (event: MessageEvent<unknown>) => {
+      if (event.source !== window.parent || event.origin !== window.location.origin) return
+      if (!isRecord(event.data) || event.data.version !== PROTOCOL_VERSION) return
+      if (event.data.frameNonce !== frameNonce) return
+
+      if (event.data.type === 'oj-ml:configure') {
+        if (settled || ojHostConfig.value !== null) {
+          postToHost({ type: 'oj-ml:bridge-error', code: 'OJ_HOST_RECONFIGURE_REJECTED' })
+          return
+        }
+        const configured = parseConfigure(event.data)
+        if (configured === null) return
+        const restRoot = sameOriginRestRoot(configured.restRoot)
+        if (restRoot === null) return
+        settled = true
+        window.clearTimeout(timeout)
+        ojHostConfig.value = { ...configured, restRoot }
+        resolve(ojHostConfig.value)
+        return
+      }
+
+      if (event.data.type === 'oj-ml:portfolio-template-apply') {
+        handlePortfolioRequest(event.data)
+        return
+      }
+
+      if (event.data.type !== 'oj-ml:storage-wipe-request' || ojHostConfig.value === null) return
+      const replyFrameNonce = frameNonce
+      const handleWipe = wipeHandler
+      if (handleWipe === null) {
+        postToHostWithNonce(
+          { type: 'oj-ml:storage-error', code: 'OJ_STORAGE_NOT_READY' },
+          replyFrameNonce,
+        )
+        return
+      }
+      void handleWipe()
+        .then(() => postToHostWithNonce({ type: 'oj-ml:storage-wiped' }, replyFrameNonce))
+        .catch(() =>
+          postToHostWithNonce(
+            { type: 'oj-ml:storage-error', code: 'OJ_STORAGE_WIPE_FAILED' },
+            replyFrameNonce,
+          ),
+        )
+    })
+
+    postToHost({ type: 'oj-ml:ready' })
+  })
+}
+
+export async function submitProjectToOjHost(blob: Blob, fileName: string): Promise<void> {
+  const config = ojHostConfig.value
+  if (config === null) throw new Error('OJ_HOST_NOT_CONFIGURED')
+  if (config.attemptId === undefined) throw new Error('OJ_ATTEMPT_NOT_CONFIGURED')
+  if (config.maxBytes !== undefined && blob.size > config.maxBytes) {
+    notifyHost('error', { message: 'OJ_SUBMISSION_TOO_LARGE' })
+    throw new Error('OJ_SUBMISSION_TOO_LARGE')
+  }
+
+  const endpoint = new URL(
+    `${config.restRoot}/attempts/${encodeURIComponent(config.attemptId)}/submit`,
+    window.location.href,
+  )
+  if (endpoint.origin !== window.location.origin) throw new Error('OJ_SUBMISSION_ORIGIN_MISMATCH')
+
+  const body = new FormData()
+  body.append('artifact', blob, fileName)
+  notifyHost('submitting', { bytes: blob.size })
+  try {
+    const response = await fetch(endpoint, {
+      method: 'POST',
+      credentials: 'same-origin',
+      headers: { 'X-WP-Nonce': config.nonce },
+      body,
+    })
+    if (!response.ok) throw new Error(`OJ_SUBMISSION_HTTP_${response.status}`)
+    const payload = (await response.json()) as SubmissionResponse
+    notifyHost('submitted', {
+      receipt: payload.data?.receipt,
+      attempt: payload.data?.attempt,
+    })
+  } catch (error) {
+    notifyHost('error', {
+      message: error instanceof Error ? error.message : 'OJ_SUBMISSION_FAILED',
+    })
+    throw error
+  }
+}
diff --git a/frontend/src/oj-portfolio-template.ts b/frontend/src/oj-portfolio-template.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b5f17891d796af0bedc8f84d0c1418c0023c29f5
--- /dev/null
+++ b/frontend/src/oj-portfolio-template.ts
@@ -0,0 +1,183 @@
+/** OJ-only, append-only assignment template adapter. Never executes project content. */
+import { watch } from 'vue'
+
+import {
+  MAX_PORTFOLIO_BYTES,
+  OJ_PORTFOLIO_MAX_SECTIONS,
+  OJ_PORTFOLIO_MAX_TEMPLATE_BYTES,
+  OJ_PORTFOLIO_MAX_TITLE_LENGTH,
+} from './limits'
+import { newProjectId, touch } from './project/create'
+import type { ProjectFile } from './project/format'
+import { portfolioBytes, withImportedSections } from './project/portfolio'
+import type { DraftSection } from './project/portfolio'
+
+export interface OjPortfolioTemplate {
+  sections: DraftSection[]
+  locale?: string
+}
+
+export interface OjPortfolioTarget {
+  projectId: string | null
+  projectToken: string | null
+  projectName: string | null
+}
+
+export interface OjPortfolioRequest {
+  requestId: string
+  projectId: string
+  projectToken: string
+  template: OjPortfolioTemplate
+}
+
+export interface OjPortfolioResult {
+  state: 'applied' | 'unchanged' | 'error'
+  added: number
+  code?: string
+}
+
+export interface OjPortfolioProject {
+  file: ProjectFile | null
+  opening: boolean
+  update(file: ProjectFile): void
+  flush(): Promise<void>
+}
+
+function record(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null && !Array.isArray(value)
+}
+
+export function parseOjPortfolioTemplate(value: unknown): OjPortfolioTemplate | null {
+  if (!record(value) || Object.keys(value).some((key) => !['sections', 'locale'].includes(key))) {
+    return null
+  }
+  if (
+    !Array.isArray(value.sections) ||
+    value.sections.length === 0 ||
+    value.sections.length > OJ_PORTFOLIO_MAX_SECTIONS ||
+    (value.locale !== undefined &&
+      (typeof value.locale !== 'string' || !/^[A-Za-z0-9-]{1,32}$/.test(value.locale)))
+  )
+    return null
+
+  const sections: DraftSection[] = []
+  const ids = new Set<string>()
+  for (const section of value.sections) {
+    if (
+      !record(section) ||
+      Object.keys(section).some((key) => !['id', 'title', 'description'].includes(key)) ||
+      typeof section.id !== 'string' ||
+      !/^[\p{L}\p{N}_-]{1,200}$/u.test(section.id) ||
+      ['__proto__', 'constructor', 'prototype'].includes(section.id) ||
+      ids.has(section.id) ||
+      typeof section.title !== 'string' ||
+      section.title.trim().length === 0 ||
+      section.title.length > OJ_PORTFOLIO_MAX_TITLE_LENGTH ||
+      (section.description !== undefined &&
+        (typeof section.description !== 'string' ||
+          section.description.length > OJ_PORTFOLIO_MAX_TEMPLATE_BYTES))
+    )
+      return null
+    ids.add(section.id)
+    sections.push({
+      id: section.id,
+      title: section.title.trim(),
+      ...(typeof section.description === 'string'
+        ? { description: section.description.trim() }
+        : {}),
+    })
+  }
+  const parsed = {
+    sections,
+    ...(typeof value.locale === 'string' ? { locale: value.locale } : {}),
+  }
+  if (
+    new TextEncoder().encode(JSON.stringify(parsed)).byteLength > OJ_PORTFOLIO_MAX_TEMPLATE_BYTES
+  ) {
+    return null
+  }
+  return parsed
+}
+
+function fail(code: string): OjPortfolioResult {
+  return { state: 'error', added: 0, code }
+}
+
+/** Token follows project identity/opening, not edits. Names are display-only. */
+export function createOjPortfolioAdapter(
+  project: OjPortfolioProject,
+  publish: (target: OjPortfolioTarget) => void,
+  showPortfolio: (projectId: string) => void,
+) {
+  let token: string | null = null
+  let active = true
+  const current = (): OjPortfolioTarget => ({
+    projectId: project.opening ? null : (project.file?.document.manifest.projectId ?? null),
+    projectToken: token,
+    projectName: project.opening ? null : (project.file?.document.manifest.name ?? null),
+  })
+  const stopIdentity = watch(
+    [() => project.file?.document.manifest.projectId ?? null, () => project.opening],
+    ([id, opening]) => {
+      token = id === null || opening ? null : newProjectId()
+      publish(current())
+    },
+    { immediate: true, flush: 'sync' },
+  )
+  const stopName = watch(
+    () => project.file?.document.manifest.name,
+    () => publish(current()),
+    { flush: 'sync' },
+  )
+
+  async function apply(request: OjPortfolioRequest): Promise<OjPortfolioResult> {
+    const matches = () =>
+      active &&
+      token !== null &&
+      request.projectToken === token &&
+      !project.opening &&
+      project.file?.document.manifest.projectId === request.projectId
+    if (!active || project.file === null || project.opening) return fail('OJ_PORTFOLIO_NO_PROJECT')
+    if (!matches()) return fail('OJ_PORTFOLIO_PROJECT_CHANGED')
+    const file = project.file
+    const before = file.document.portfolio
+    for (const incoming of request.template.sections) {
+      const existing = before.template.sections.find((section) => section.id === incoming.id)
+      if (
+        existing !== undefined &&
+        (existing.title.trim() !== incoming.title.trim() ||
+          (existing.description ?? '').trim() !== (incoming.description ?? '').trim())
+      ) {
+        return fail('OJ_PORTFOLIO_TEMPLATE_CONFLICT')
+      }
+    }
+    const next = withImportedSections(before, request.template.sections, request.template.locale)
+    if (portfolioBytes(next, file.attachments) > MAX_PORTFOLIO_BYTES)
+      return fail('OJ_PORTFOLIO_TOO_LARGE')
+    const added = next.template.sections.length - before.template.sections.length
+    try {
+      if (next !== before)
+        project.update({
+          ...file,
+          document: touch({ ...file.document, portfolio: next }, new Date().toISOString()),
+        })
+      await project.flush()
+    } catch {
+      return fail(matches() ? 'OJ_PORTFOLIO_SAVE_FAILED' : 'OJ_PORTFOLIO_PROJECT_CHANGED')
+    }
+    if (!matches()) return fail('OJ_PORTFOLIO_PROJECT_CHANGED')
+    showPortfolio(request.projectId)
+    return { state: added > 0 ? 'applied' : 'unchanged', added }
+  }
+
+  return {
+    current,
+    apply,
+    dispose() {
+      active = false
+      token = null
+      stopIdentity()
+      stopName()
+    },
+  }
+}
diff --git a/frontend/src/oj-storage-scope.ts b/frontend/src/oj-storage-scope.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d715b5b4c40dd495ec96f4b342f29b7b7304fe3c
--- /dev/null
+++ b/frontend/src/oj-storage-scope.ts
@@ -0,0 +1,586 @@
+/**
+ * OJ 공용 PC 모드의 브라우저 저장소 경계.
+ *
+ * 같은 브라우저 프로필을 여러 학생이 써도 프로젝트가 섞이지 않도록 DB 이름을
+ * 불투명 사용자 scope로 나눈다. DB를 직접 열어 보더라도 내용을 읽지 못하도록
+ * 프로젝트 payload는 서버가 현재 사용자에게만 발급한 AES-GCM 키로 봉인한다.
+ */
+
+import { ClientError } from './errors'
+
+const SCOPE_PATTERN = /^[A-Za-z0-9_-]{20,64}$/
+const KEY_PATTERN = /^[A-Za-z0-9_-]{43}$/
+const KEY_BYTES = 32
+const IV_BYTES = 12
+const ENCRYPTION_VERSION = 1 as const
+
+export const OJ_STORAGE_CONTROL_CHANNEL_PREFIX = 'ml-playgrounds:oj-storage-control-v1:'
+export const OJ_STORAGE_LOCK_PREFIX = 'ml-playgrounds:oj-storage-wipe-v1:'
+export const OJ_STORAGE_REVOKE_MESSAGE_TYPE = 'oj-ml:storage-revoke'
+
+export interface OjStorageRevokeMessage {
+  readonly type: typeof OJ_STORAGE_REVOKE_MESSAGE_TYPE
+  readonly version: 1
+  readonly scope: string
+}
+
+export type OjStorageCheckpoint = () => void
+export type OjStorageRevocationReason = 'local-wipe' | 'peer' | 'database-blocking' | 'boot-failure'
+export type OjStorageRevokeHandler = (reason: OjStorageRevocationReason) => void | Promise<void>
+
+export interface SealedBytes {
+  readonly version: typeof ENCRYPTION_VERSION
+  readonly iv: Uint8Array
+  readonly ciphertext: Uint8Array
+}
+
+interface StorageScope {
+  readonly id: string
+  readonly rawKey: Uint8Array
+  readonly channel: BroadcastChannel | null
+  generation: number
+  revoked: boolean
+}
+
+let configured: StorageScope | null = null
+let encryptionKey: Promise<CryptoKey> | null = null
+let hmacKey: Promise<CryptoKey> | null = null
+let activeOperations = 0
+const quiescenceWaiters = new Set<() => void>()
+const revokeHandlers = new Set<OjStorageRevokeHandler>()
+const scheduledRevokeHandlers = new Set<OjStorageRevokeHandler>()
+const revokeTasks: Promise<void>[] = []
+let leaseHeld = false
+let sharedLeaseRelease: (() => void) | null = null
+let sharedLeaseTask: Promise<void> | null = null
+let leaseReady: Promise<void> | null = null
+let revocationBarrier: Promise<void> | null = null
+let revocationReason: OjStorageRevocationReason | null = null
+
+/** TypeScript의 ArrayBufferLike 추론을 피하면서 Web Crypto에 넘길 소유 버퍼를 만든다. */
+function asArrayBuffer(bytes: Uint8Array): ArrayBuffer {
+  const copy = new Uint8Array(bytes.byteLength)
+  copy.set(bytes)
+  return copy.buffer
+}
+
+/** IndexedDB 구조화 복제나 iframe 경계를 건너도 동작하는 Uint8Array 판정. */
+function isUint8Array(value: unknown): value is Uint8Array {
+  return Object.prototype.toString.call(value) === '[object Uint8Array]'
+}
+
+function decodeBase64Url(value: string): Uint8Array {
+  const padded =
+    value.replace(/-/g, '+').replace(/_/g, '/') + '='.repeat((4 - (value.length % 4)) % 4)
+  let decoded = ''
+  try {
+    decoded = window.atob(padded)
+  } catch {
+    throw new ClientError('STORAGE_LOCKED')
+  }
+  return Uint8Array.from(decoded, (character) => character.charCodeAt(0))
+}
+
+export function ojStorageControlChannelName(scope: string): string {
+  if (!SCOPE_PATTERN.test(scope)) throw new ClientError('STORAGE_LOCKED')
+  return `${OJ_STORAGE_CONTROL_CHANNEL_PREFIX}${scope}`
+}
+
+export function ojStorageRevokeMessage(scope: string): OjStorageRevokeMessage {
+  if (!SCOPE_PATTERN.test(scope)) throw new ClientError('STORAGE_LOCKED')
+  return { type: OJ_STORAGE_REVOKE_MESSAGE_TYPE, version: 1, scope }
+}
+
+export function ojStorageLockName(scope: string): string {
+  if (!SCOPE_PATTERN.test(scope)) throw new ClientError('STORAGE_LOCKED')
+  return `${OJ_STORAGE_LOCK_PREFIX}${scope}`
+}
+
+function isRevokeMessage(value: unknown, scope: string): value is OjStorageRevokeMessage {
+  if (typeof value !== 'object' || value === null) return false
+  const candidate = value as { type?: unknown; version?: unknown; scope?: unknown }
+  return (
+    candidate.type === OJ_STORAGE_REVOKE_MESSAGE_TYPE &&
+    candidate.version === 1 &&
+    candidate.scope === scope
+  )
+}
+
+function scheduleRevokeHandler(handler: OjStorageRevokeHandler): void {
+  if (scheduledRevokeHandlers.has(handler)) return
+  scheduledRevokeHandlers.add(handler)
+  const reason = revocationReason ?? 'peer'
+  const task = Promise.resolve().then(() => handler(reason))
+  revokeTasks.push(task)
+  // Remote revocation has no caller to observe cleanup failures. Keep the rejection handled;
+  // a later local wipe still observes it through Promise.allSettled below.
+  void task.catch(() => undefined)
+}
+
+function notifyQuiescence(): void {
+  if (activeOperations !== 0) return
+  for (const resolve of quiescenceWaiters) resolve()
+  quiescenceWaiters.clear()
+}
+
+function waitForQuiescence(): Promise<void> {
+  if (activeOperations === 0) return Promise.resolve()
+  return new Promise((resolve) => quiescenceWaiters.add(resolve))
+}
+
+async function settleRevokeHandlers(): Promise<void> {
+  let cursor = 0
+  let firstFailure: unknown
+  while (cursor < revokeTasks.length) {
+    const batch = revokeTasks.slice(cursor)
+    cursor = revokeTasks.length
+    const results = await Promise.allSettled(batch)
+    firstFailure ??= results.find(
+      (result): result is PromiseRejectedResult => result.status === 'rejected',
+    )?.reason
+  }
+  if (firstFailure !== undefined) throw firstFailure
+}
+async function finishRevocation(): Promise<void> {
+  let failure: unknown
+  try {
+    // Revoke handlers close the project store and IndexedDB connection before the lease is released.
+    await settleRevokeHandlers()
+  } catch (error) {
+    failure = error
+  }
+  await waitForQuiescence()
+
+  const releaseLease = sharedLeaseRelease
+  sharedLeaseRelease = null
+  releaseLease?.()
+  // Resolving the hold promise is not itself a Web Locks release barrier.
+  await sharedLeaseTask?.catch(() => undefined)
+
+  if (failure !== undefined) throw failure
+}
+
+function ensureRevocationBarrier(): Promise<void> {
+  revocationBarrier ??= finishRevocation()
+  void revocationBarrier.catch(() => undefined)
+  return revocationBarrier
+}
+
+function beginRevocation(broadcast: boolean, reason: OjStorageRevocationReason): void {
+  const scope = configuredScope()
+  if (scope.revoked) return
+
+  // The state transition is deliberately synchronous. A late promise continuation or an
+  // IndexedDB blocking callback cannot reopen the vault before BroadcastChannel delivery.
+  scope.revoked = true
+  revocationReason = reason
+  scope.generation += 1
+  scope.rawKey.fill(0)
+  encryptionKey = null
+  hmacKey = null
+
+  if (broadcast) {
+    try {
+      scope.channel?.postMessage(ojStorageRevokeMessage(scope.id))
+    } catch {
+      // The local generation barrier remains authoritative when messaging is unavailable.
+    }
+  }
+  for (const handler of revokeHandlers) scheduleRevokeHandler(handler)
+  void ensureRevocationBarrier()
+}
+
+function openControlChannel(scope: string): BroadcastChannel | null {
+  if (typeof BroadcastChannel === 'undefined') return null
+  try {
+    const channel = new BroadcastChannel(ojStorageControlChannelName(scope))
+    channel.addEventListener('message', (event: MessageEvent<unknown>) => {
+      if (!isRevokeMessage(event.data, scope)) return
+      beginRevocation(false, 'peer')
+    })
+    return channel
+  } catch {
+    return null
+  }
+}
+
+/** 앱이 저장소를 열기 전에 정확히 한 번 설정한다. */
+export function configureOjStorageScope(scope: string, encodedKey: string): void {
+  if (!SCOPE_PATTERN.test(scope) || !KEY_PATTERN.test(encodedKey)) {
+    throw new ClientError('STORAGE_LOCKED')
+  }
+  const rawKey = decodeBase64Url(encodedKey)
+  if (rawKey.byteLength !== KEY_BYTES) {
+    rawKey.fill(0)
+    throw new ClientError('STORAGE_LOCKED')
+  }
+
+  if (configured !== null) {
+    const reusable = configured.id === scope && !configured.revoked
+    rawKey.fill(0)
+    if (!reusable) throw new ClientError('STORAGE_LOCKED')
+    return
+  }
+
+  configured = {
+    id: scope,
+    rawKey,
+    channel: openControlChannel(scope),
+    generation: 0,
+    revoked: false,
+  }
+}
+function storageLockManager(): LockManager {
+  try {
+    const manager = navigator.locks
+    if (manager === undefined) throw new ClientError('STORAGE_LOCKED')
+    return manager
+  } catch (error) {
+    if (error instanceof ClientError) throw error
+    throw new ClientError('STORAGE_LOCKED')
+  }
+}
+
+type OjStorageLockOutcome<T> =
+  { readonly ok: true; readonly value: T } | { readonly ok: false; readonly error: unknown }
+
+function storageLockError(error: unknown): ClientError {
+  return error instanceof ClientError ? error : new ClientError('STORAGE_LOCKED')
+}
+
+async function startStorageLease(): Promise<void> {
+  const scope = activeScope()
+  if (scope.channel === null) throw new ClientError('STORAGE_LOCKED')
+  const checkpoint = checkpointFor(scope, scope.generation)
+  const manager = storageLockManager()
+  let resolveAcquired: (() => void) | null = null
+  let rejectAcquired: ((reason?: unknown) => void) | null = null
+  const acquired = new Promise<void>((resolve, reject) => {
+    resolveAcquired = resolve
+    rejectAcquired = reject
+  })
+  let releaseLease: () => void = () => undefined
+  const hold = new Promise<void>((resolve) => {
+    releaseLease = resolve
+  })
+  sharedLeaseRelease = releaseLease
+
+  try {
+    sharedLeaseTask = manager
+      .request(ojStorageLockName(scope.id), { mode: 'shared' }, async (lock) => {
+        if (lock === null) throw new ClientError('STORAGE_LOCKED')
+        checkpoint()
+        leaseHeld = true
+        resolveAcquired?.()
+        try {
+          await hold
+        } finally {
+          leaseHeld = false
+        }
+      })
+      .then(() => undefined)
+  } catch (error) {
+    sharedLeaseRelease = null
+    releaseLease()
+    throw error instanceof ClientError ? error : new ClientError('STORAGE_LOCKED')
+  }
+
+  void sharedLeaseTask.catch((error: unknown) => {
+    rejectAcquired?.(error instanceof ClientError ? error : new ClientError('STORAGE_LOCKED'))
+  })
+  await acquired
+  checkpoint()
+  if (!leaseHeld) throw new ClientError('STORAGE_LOCKED')
+}
+
+/**
+ * Holds a shared lock for the entire live app session. A wipe takes the same scope's exclusive
+ * lock, so BroadcastChannel delivery can be arbitrarily delayed without allowing early success.
+ */
+export function acquireOjStorageLease(): Promise<void> {
+  leaseReady ??= startStorageLease()
+  return leaseReady
+}
+
+/**
+ * Queues the exclusive gate before revocation so a tab opened after the one-shot broadcast cannot
+ * acquire a shared lease ahead of this wipe.
+ */
+export async function revokeAndWithOjStorageExclusiveWipe<T>(
+  operation: () => Promise<T>,
+): Promise<T> {
+  const scope = configuredScope()
+  if (scope.revoked || !leaseHeld) throw new ClientError('STORAGE_LOCKED')
+  const manager = storageLockManager()
+  let request: Promise<T>
+  try {
+    request = manager.request(ojStorageLockName(scope.id), { mode: 'exclusive' }, async (lock) => {
+      if (lock === null || !scope.revoked) throw new ClientError('STORAGE_LOCKED')
+      await ensureRevocationBarrier()
+      return operation()
+    })
+  } catch (error) {
+    throw storageLockError(error)
+  }
+
+  const state: { outcome: OjStorageLockOutcome<T> | null } = { outcome: null }
+  const observed = request.then(
+    (value): OjStorageLockOutcome<T> => (state.outcome = { ok: true, value }),
+    (error): OjStorageLockOutcome<T> => (state.outcome = { ok: false, error }),
+  )
+
+  // Web Locks has no queue acknowledgement. Observe synchronous/WebIDL rejection before making
+  // revocation terminal; the already-issued valid request is FIFO-queued during this checkpoint.
+  await Promise.resolve().then(() => undefined)
+  const early = state.outcome
+  if (early !== null) {
+    if (!early.ok) throw storageLockError(early.error)
+    throw new ClientError('STORAGE_LOCKED')
+  }
+
+  beginRevocation(true, 'local-wipe')
+  const result = await observed
+  if (!result.ok) throw storageLockError(result.error)
+  return result.value
+}
+
+/**
+ * Scope identity is retained after revoke. Returning false here would make callers fall through to
+ * the unscoped standalone database and turn a fail-closed wipe into a cross-user data leak.
+ */
+export function hasOjStorageScope(): boolean {
+  return configured !== null
+}
+
+export function isOjStorageScopeRevoked(): boolean {
+  return configured?.revoked ?? false
+}
+
+export function scopedDatabaseName(baseName: string): string {
+  return configured === null ? baseName : `${baseName}-oj-v1-${configured.id}`
+}
+
+export function scopedLocalStorageKey(baseKey: string): string {
+  if (configured === null) return baseKey
+  const scope = activeScope()
+  return `${baseKey}:oj:${scope.id}`
+}
+
+export function deleteScopedLocalPreferences(): void {
+  const scope = configuredScope()
+  const suffix = `:oj:${scope.id}`
+  try {
+    for (let index = window.localStorage.length - 1; index >= 0; index -= 1) {
+      const key = window.localStorage.key(index)
+      if (key?.startsWith('ml-playgrounds:') && key.endsWith(suffix)) {
+        window.localStorage.removeItem(key)
+      }
+    }
+  } catch {
+    // IndexedDB vault deletion remains authoritative; unavailable preferences are non-sensitive.
+  }
+}
+
+/** OJ 전용 번들은 소유자를 알 수 없는 standalone 화면 설정도 자동 귀속하지 않는다. */
+export function deleteLegacyLocalPreferences(): void {
+  try {
+    for (let index = window.localStorage.length - 1; index >= 0; index -= 1) {
+      const key = window.localStorage.key(index)
+      if (key?.startsWith('ml-playgrounds:') && !key.includes(':oj:')) {
+        window.localStorage.removeItem(key)
+      }
+    }
+  } catch {
+    // 사생활 보호 모드에서는 localStorage 열람 자체가 실패할 수 있다.
+  }
+}
+
+function configuredScope(): StorageScope {
+  if (configured === null) throw new ClientError('STORAGE_LOCKED')
+  return configured
+}
+
+function activeScope(): StorageScope {
+  const scope = configuredScope()
+  if (scope.revoked) throw new ClientError('STORAGE_LOCKED')
+  return scope
+}
+
+function checkpointFor(scope: StorageScope, generation: number): OjStorageCheckpoint {
+  return () => {
+    if (configured !== scope || scope.revoked || scope.generation !== generation) {
+      throw new ClientError('STORAGE_LOCKED')
+    }
+  }
+}
+
+function assertLeaseHeld(): void {
+  if (!leaseHeld) throw new ClientError('STORAGE_LOCKED')
+}
+
+export function captureOjStorageCheckpoint(): OjStorageCheckpoint {
+  const scope = activeScope()
+  assertLeaseHeld()
+  return checkpointFor(scope, scope.generation)
+}
+
+export function assertOjStorageActive(): void {
+  activeScope()
+  assertLeaseHeld()
+}
+
+/**
+ * Tracks an operation across every async gap. Revocation rejects new work synchronously and waits
+ * for existing work to observe its generation checkpoint before wipe acknowledgement.
+ */
+export async function withOjStorageOperation<T>(
+  operation: (checkpoint: OjStorageCheckpoint) => Promise<T>,
+): Promise<T> {
+  const checkpoint = captureOjStorageCheckpoint()
+  activeOperations += 1
+  try {
+    checkpoint()
+    const result = await operation(checkpoint)
+    checkpoint()
+    return result
+  } finally {
+    activeOperations -= 1
+    notifyQuiescence()
+  }
+}
+
+export function registerOjStorageRevokeHandler(handler: OjStorageRevokeHandler): () => void {
+  revokeHandlers.add(handler)
+  if (configured?.revoked) scheduleRevokeHandler(handler)
+  return () => revokeHandlers.delete(handler)
+}
+
+/** Fails closed when host verification, lease acquisition, or pre-mount cleanup cannot finish. */
+export async function revokeOjStorageScopeForBootstrapFailure(): Promise<void> {
+  beginRevocation(true, 'boot-failure')
+  await ensureRevocationBarrier()
+}
+
+/**
+ * Called synchronously by IndexedDB's versionchange/delete blocking callback. It must publish a
+ * revoke itself because the deleting parent can finish before BroadcastChannel reaches this tab.
+ */
+export function revokeOjStorageScopeFromDatabaseBlocking(): void {
+  beginRevocation(true, 'database-blocking')
+}
+
+function importedEncryptionKey(): Promise<CryptoKey> {
+  const scope = activeScope()
+  encryptionKey ??= window.crypto.subtle.importKey(
+    'raw',
+    asArrayBuffer(scope.rawKey),
+    { name: 'AES-GCM' },
+    false,
+    ['encrypt', 'decrypt'],
+  )
+  return encryptionKey
+}
+
+function importedHmacKey(): Promise<CryptoKey> {
+  const scope = activeScope()
+  hmacKey ??= window.crypto.subtle.importKey(
+    'raw',
+    asArrayBuffer(scope.rawKey),
+    { name: 'HMAC', hash: 'SHA-256' },
+    false,
+    ['sign'],
+  )
+  return hmacKey
+}
+
+function additionalData(scope: string, purpose: string): Uint8Array {
+  return new TextEncoder().encode(`oj-ml-storage-v1\u0000${scope}\u0000${purpose}`)
+}
+
+export async function sealBytes(bytes: Uint8Array, purpose: string): Promise<SealedBytes> {
+  const scope = activeScope()
+  const checkpoint = checkpointFor(scope, scope.generation)
+  const iv = window.crypto.getRandomValues(new Uint8Array(IV_BYTES))
+  try {
+    const ciphertext = await window.crypto.subtle.encrypt(
+      {
+        name: 'AES-GCM',
+        iv: asArrayBuffer(iv),
+        additionalData: asArrayBuffer(additionalData(scope.id, purpose)),
+        tagLength: 128,
+      },
+      await importedEncryptionKey(),
+      asArrayBuffer(bytes),
+    )
+    checkpoint()
+    return { version: ENCRYPTION_VERSION, iv, ciphertext: new Uint8Array(ciphertext) }
+  } catch (error) {
+    if (error instanceof ClientError) throw error
+    throw new ClientError('STORAGE_LOCKED')
+  }
+}
+
+export async function openBytes(sealed: SealedBytes, purpose: string): Promise<Uint8Array> {
+  if (
+    sealed?.version !== ENCRYPTION_VERSION ||
+    !isUint8Array(sealed.iv) ||
+    sealed.iv.byteLength !== IV_BYTES ||
+    !isUint8Array(sealed.ciphertext)
+  ) {
+    throw new ClientError('STORAGE_LOCKED')
+  }
+  const scope = activeScope()
+  const checkpoint = checkpointFor(scope, scope.generation)
+  try {
+    const plaintext = await window.crypto.subtle.decrypt(
+      {
+        name: 'AES-GCM',
+        iv: asArrayBuffer(sealed.iv),
+        additionalData: asArrayBuffer(additionalData(scope.id, purpose)),
+        tagLength: 128,
+      },
+      await importedEncryptionKey(),
+      asArrayBuffer(sealed.ciphertext),
+    )
+    checkpoint()
+    return new Uint8Array(plaintext)
+  } catch (error) {
+    if (error instanceof ClientError) throw error
+    throw new ClientError('STORAGE_LOCKED')
+  }
+}
+
+export async function sealJson(value: unknown, purpose: string): Promise<SealedBytes> {
+  return sealBytes(new TextEncoder().encode(JSON.stringify(value)), purpose)
+}
+
+export async function openJson<T>(sealed: SealedBytes, purpose: string): Promise<T> {
+  try {
+    return JSON.parse(
+      new TextDecoder('utf-8', { fatal: true }).decode(await openBytes(sealed, purpose)),
+    ) as T
+  } catch (error) {
+    if (error instanceof ClientError) throw error
+    throw new ClientError('STORAGE_LOCKED')
+  }
+}
+
+/** 모델 경로처럼 IndexedDB keyPath에 필요한 값은 비밀 키 기반 불투명 키로 바꾼다. */
+export async function opaqueStorageKey(purpose: string, value: string): Promise<string> {
+  const scope = activeScope()
+  const checkpoint = checkpointFor(scope, scope.generation)
+  try {
+    const signature = await window.crypto.subtle.sign(
+      'HMAC',
+      await importedHmacKey(),
+      asArrayBuffer(new TextEncoder().encode(`${purpose}\u0000${value}`)),
+    )
+    checkpoint()
+    return Array.from(new Uint8Array(signature), (byte) => byte.toString(16).padStart(2, '0')).join(
+      '',
+    )
+  } catch (error) {
+    if (error instanceof ClientError) throw error
+    throw new ClientError('STORAGE_LOCKED')
+  }
+}

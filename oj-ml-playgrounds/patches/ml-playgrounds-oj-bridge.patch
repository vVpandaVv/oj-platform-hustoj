+import { createPinia, setActivePinia } from 'pinia'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { writeProject } from '../src/project/format'
+import { exportIdentifiedProject } from '../src/project/identified-export'
+import { saveProject, markExported } from '../src/project/storage'
+import { useProjectStore } from '../src/stores/project'
+import { projectFile } from './fixtures/project'
+
+vi.mock('../src/project/storage', async (original) => ({
+  ...(await original<typeof import('../src/project/storage')>()),
+  saveProject: vi.fn(),
+  markExported: vi.fn(),
+  requestPersistence: vi.fn(async () => false),
+}))
+vi.mock('../src/project/format', async (original) => ({
+  ...(await original<typeof import('../src/project/format')>()),
+  writeProject: vi.fn(),
+}))
+
+const output = () => ({ blob: new Blob(['mlpx']), dropped: [], contentHash: 'a'.repeat(64) })
+function deferred<T>() {
+  let resolve!: (value: T) => void
+  const promise = new Promise<T>((done) => {
+    resolve = done
+  })
+  return { promise, resolve }
+}
+beforeEach(() => {
+  setActivePinia(createPinia())
+  vi.mocked(saveProject).mockResolvedValue(undefined)
+  vi.mocked(markExported).mockResolvedValue(undefined)
+  vi.mocked(writeProject).mockResolvedValue(output())
+})
+afterEach(() => {
+  useProjectStore().close()
+  vi.resetAllMocks()
+})
+
+describe('real project store snapshot boundary', () => {
+  it.each(['project-switch', 'selection-change'])(
+    'rejects %s during flush before serializing or delivering',
+    async (change) => {
+      const store = useProjectStore()
+      const snapshot = projectFile()
+      store.update(snapshot)
+      const flush = deferred<void>()
+      vi.mocked(saveProject).mockReturnValueOnce(flush.promise)
+      const deliver = vi.fn()
+      const exportPromise = store.exportFile('# report', deliver, snapshot)
+      const rejected = expect(exportPromise).rejects.toThrow('PROJECT_CHANGED_DURING_EXPORT')
+      const changed = projectFile()
+      if (change === 'project-switch') changed.document.manifest.projectId = 'another-project'
+      else changed.document.settings.selectedAlgorithms = [{ algorithm: 'random_forest' }]
+      store.update(changed)
+      flush.resolve()
+      await rejected
+      expect(writeProject).not.toHaveBeenCalled()
+      expect(deliver).not.toHaveBeenCalled()
+      expect(markExported).not.toHaveBeenCalled()
+      expect(store.file).toBe(changed)
+    },
+  )
+
+  it('rejects a change while serialization is pending before delivery', async () => {
+    const store = useProjectStore()
+    const snapshot = projectFile()
+    store.update(snapshot)
+    const started = deferred<void>()
+    const serialized = deferred<ReturnType<typeof output>>()
+    vi.mocked(writeProject).mockImplementationOnce(() => {
+      started.resolve()
+      return serialized.promise
+    })
+    const deliver = vi.fn()
+    const exportPromise = store.exportFile('# report', deliver, snapshot)
+    const rejected = expect(exportPromise).rejects.toThrow('PROJECT_CHANGED_DURING_EXPORT')
+    await started.promise
+    store.update(projectFile())
+    serialized.resolve(output())
+    await rejected
+    expect(writeProject).toHaveBeenCalledWith(snapshot, '# report')
+    expect(deliver).not.toHaveBeenCalled()
+    expect(markExported).not.toHaveBeenCalled()
+  })
+
+  it('delivers the exact identified in-memory snapshot when unchanged', async () => {
+    const store = useProjectStore()
+    store.update(projectFile())
+    const deliver = vi.fn()
+    await exportIdentifiedProject(
+      store,
+      { name: 'Same snapshot', studentId: 'student-1', studentName: 'Learner' },
+      (key) => key,
+      'ko',

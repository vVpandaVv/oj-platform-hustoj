+
+describe('bounded classification metrics', () => {
+  it('keeps exact scores for 8,760 rows / 2,166 classes without a quadratic matrix', () => {
+    const actual = dataset(2166, 8760).rows.map((row) => row[1]!)
+    const predicted = actual.map((label) => (label === '0' ? '1' : label))
+    const result = evaluate('classification', actual, predicted)
+    expect(result.confusionMatrix).toBeUndefined()
+    expect(result.perClass).toHaveLength(2166)
+    expect(result.metrics.accuracy).toBe((8760 - 5) / 8760)
+    expect(result.metrics.f1Macro).toBeCloseTo((2164 + 2 / 3) / 2166, 12)
+    expect(result.perClass?.find((entry) => entry.label === '0')).toEqual({
+      label: '0',
+      support: 5,
+      precision: 0,
+      recall: 0,
+      specificity: 1,
+      f1: 0,
+    })
+    expect(result.perClass?.find((entry) => entry.label === '1')).toEqual({
+      label: '1',
+      support: 5,
+      precision: 0.5,
+      recall: 1,
+      specificity: 8750 / 8755,
+      f1: 2 / 3,
+    })
+    // The persisted result scales with classes, not the 4,691,556 possible pairs.
+    expect(JSON.stringify(result).length).toBeLessThan(800_000)
+  })
+
+  it('retains the old matrix format through the exact boundary, including predicted-only classes', () => {
+    const labels = dataset(MAX_DENSE_CLASSIFICATION_LABELS).rows.map((row) => row[1]!)
+    const small = evaluate('classification', labels, labels)
+    expect(small.confusionMatrix?.matrix).toHaveLength(MAX_DENSE_CLASSIFICATION_LABELS)
+    expect(small.metrics).toEqual({ accuracy: 1, f1Macro: 1 })
+    const novel = [...labels]
+    novel[0] = 'new-prediction'
+    const large = evaluate('classification', labels, novel)
+    expect(large.confusionMatrix).toBeUndefined()
+    expect(large.perClass).toHaveLength(MAX_DENSE_CLASSIFICATION_LABELS + 1)
+    expect(large.perClass?.find((entry) => entry.label === 'new-prediction')).toMatchObject({
+      support: 0,
+      precision: 0,
+      recall: 0,
+      f1: 0,
+    })
+  })
+})
+
+describe('classification notice before training', () => {
+  it('reports 2,166 numeric classes without changing data or settings', () => {
+    const input = {
+      dataset: dataset(2166, 8760),
+      settings: settings(),
+      taskType: 'classification' as const,
+    }
+    const before = JSON.stringify(input)
+    expect(classificationMemoryNotice(input)).toEqual({
+      target: 'target',
+      classes: 2166,
+      numeric: true,
+    })
+    expect(JSON.stringify(input)).toBe(before)
+  })
+
+  it('uses training missing-value and label trimming rules, not raw unique values', () => {
+    const data = dataset(51)
+    const rows = [...data.rows, ['1', ' 0 '], ['1', ' '], ['', 'dropped']]
+    const current = settings()
+    expect(
+      classificationMemoryNotice({
+        dataset: { ...data, rows },
+        settings: current,
+        taskType: 'classification',

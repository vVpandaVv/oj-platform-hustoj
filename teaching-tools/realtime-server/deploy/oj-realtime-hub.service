[Unit]
Description=OJ Realtime Hub
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/oj-realtime-hub
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=3
User=www-data
Group=www-data
Environment=NODE_ENV=production
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target

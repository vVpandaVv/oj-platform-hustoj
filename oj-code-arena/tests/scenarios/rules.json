        },
        {
          "do": "submit",
          "id": "2",
          "text": "print ( \"a b\" )",
          "expect": {
            "correct": true,
            "solved": [
              0
            ],
            "solvedCount": 1,
            "occ": {
              "0": null
            }
          }
        },
        {
          "do": "occupy",
          "id": "1",
          "expect": {
            "ok": false,
            "why": "solved"
          }
        }
      ]
    },
    {
      "name": "occupation times out, pause stops the clock",
      "players": [
        {
          "id": "1",
          "r": 0,
          "c": 1
        }
      ],
      "steps": [
        {
          "do": "occupy",
          "id": "1",
          "expect": {
            "ok": true
          }
        },
        {
          "do": "advance",
          "ms": 20000
        },
        {
          "do": "pause",
          "on": true

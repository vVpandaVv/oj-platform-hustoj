          "do": "advance",
          "ms": 60000,
          "expect": {
            "occ": {
              "1": "1"
            }
          }
        },
        {
          "do": "pause",
          "on": false
        },
        {
          "do": "advance",
          "ms": 9000,
          "expect": {
            "occ": {
              "1": "1"
            }
          }
        },
        {
          "do": "advance",
          "ms": 2000,
          "expect": {
            "occ": {
              "1": null
            }
          }
        }
      ]

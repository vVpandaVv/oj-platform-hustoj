    {
      "name": "occupy, taken, wrong and right answers",
      "cells": {
        "0": "print('a b')"
      },
      "players": [
        {
          "id": "1",
          "r": 0,
          "c": 0
        },
        {
          "id": "2",
          "r": 0,
          "c": 0

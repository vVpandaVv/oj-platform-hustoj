# 코드 아레나 게임 서버 설정 — OJ 콘솔 [교사 메뉴 › 코드 아레나 › 설정] 화면의 ".env" 상자를 그대로 붙여 넣으세요.

# WordPress 와 같은 비밀키 (32자 이상)
ARENA_SECRET=

# 경기 결과를 저장할 WordPress REST 주소
WP_API=https://oj.example.com/wp-json/oj-code-arena/v1

# 웹소켓 접속을 허용할 사이트 주소 (쉼표로 여러 개)
ALLOWED_ORIGINS=https://oj.example.com

# 서버가 듣는 주소와 포트, 웹소켓 경로
PORT=3200
HOST=127.0.0.1
WS_PATH=/arena

{
  "name": "codingpanda/oj-platform",
  "description": "학습용 프로그래밍 채점 시스템 WordPress 플러그인",
  "type": "wordpress-plugin",
  "license": "GPL-3.0-or-later",
  "require": {
    "php": ">=8.3",
    "ext-dom": "*",
    "ext-fileinfo": "*",
    "ext-mysqli": "*",
    "ext-openssl": "*",
    "ext-xmlwriter": "*",
    "ext-zip": "*"
  },
  "autoload": {
    "psr-4": {
      "CodingPanda\\OjPlatform\\Modules\\": "modules/",
      "CodingPanda\\OjPlatform\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CodingPanda\\OjPlatform\\Tests\\": "tests/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  },
